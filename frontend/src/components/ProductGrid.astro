---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;

const grid = "projects";
---

<section
	class="product-grid"
	id="grid"
	data-grid={grid}
>
	{projects.map((project) => {
		const currentCategory =
			project.data.category || "None";

		return (
			<div
				data-category={currentCategory}
				class="grid-item"
			>
				<ProductCard
					product={project}
				/>
			</div>
		);
	})}
</section>


<!-- ========================================
     首頁 Lightbox

     只有 mode="zoom" 的作品會使用

     每個作品都有自己的圖片組：
     cover
     +
     Markdown 內文圖片

     例如 About Me：
     1 / 5
     2 / 5
     3 / 5
     4 / 5
     5 / 5
======================================== -->

<div
	id="lightbox-modal"
	class="lightbox"
	aria-hidden="true"
>
	<div
		class="lightbox-backdrop"
	></div>

	<button
		type="button"
		class="lightbox-close"
		aria-label="關閉"
	>
		×
	</button>

	<button
		type="button"
		class="lightbox-prev"
		aria-label="上一張"
	>
		←
	</button>

	<div class="lightbox-content">

		<img
			id="lightbox-img"
			src=""
			alt=""
			draggable="false"
		/>

		<div
			id="lightbox-title"
			class="lightbox-title"
		></div>

		<div
			id="lightbox-meta"
			class="lightbox-meta"
		></div>

		<div
			id="lightbox-counter"
			class="lightbox-counter"
		>
			1 / 1
		</div>

	</div>

	<button
		type="button"
		class="lightbox-next"
		aria-label="下一張"
	>
		→
	</button>
</div>


<script>
	/*
	 * ========================================
	 * 防止 Astro 導頁後重複建立事件
	 * ========================================
	 */

	let lightboxInitialized = false;

	function initLightbox() {

		if (lightboxInitialized) {
			return;
		}

		lightboxInitialized = true;


		const modal =
			document.getElementById(
				"lightbox-modal"
			);

		const lightboxImg =
			document.getElementById(
				"lightbox-img"
			);

		const title =
			document.getElementById(
				"lightbox-title"
			);

		const meta =
			document.getElementById(
				"lightbox-meta"
			);

		const counter =
			document.getElementById(
				"lightbox-counter"
			);

		const closeBtn =
			modal?.querySelector(
				".lightbox-close"
			);

		const prevBtn =
			modal?.querySelector(
				".lightbox-prev"
			);

		const nextBtn =
			modal?.querySelector(
				".lightbox-next"
			);

		const backdrop =
			modal?.querySelector(
				".lightbox-backdrop"
			);


		if (
			!modal ||
			!lightboxImg ||
			!title ||
			!meta ||
			!counter ||
			!closeBtn ||
			!prevBtn ||
			!nextBtn ||
			!backdrop
		) {
			return;
		}


		/*
		 * ========================================
		 * 目前正在看的作品圖片
		 * ========================================
		 */

		let gallery = [];

		let currentIndex = 0;

		let touchStartX = 0;


		/*
		 * ========================================
		 * 讀取目前點擊的作品
		 * ========================================
		 */

		function getGallery(card) {

			const galleryData =
				card.getAttribute(
					"data-zoom-gallery"
				);

			if (!galleryData) {
				return [];
			}

			try {

				const images =
					JSON.parse(
						galleryData
					);

				if (
					!Array.isArray(images)
				) {
					return [];
				}

				return images.filter(
					(image) =>
						typeof image ===
						"string" &&
						image.length > 0
				);

			} catch {
				return [];
			}
		}


		/*
		 * ========================================
		 * 顯示指定圖片
		 * ========================================
		 */

		function showImage(index) {

			if (!gallery.length) {
				return;
			}


			/*
			 * 循環切換
			 */

			if (index < 0) {

				index =
					gallery.length - 1;

			}

			if (
				index >= gallery.length
			) {

				index = 0;

			}


			currentIndex = index;


			const image =
				gallery[
					currentIndex
				];


			lightboxImg.src =
				image;


			/*
			 * 如果圖片本身載入失敗
			 * 就不留下舊圖片
			 */

			lightboxImg.onerror =
				() => {
					lightboxImg.src =
						image;
				};


			counter.textContent =
				`${currentIndex + 1} / ${gallery.length}`;
		}


		/*
		 * ========================================
		 * 開啟 Lightbox
		 * ========================================
		 */

		function openLightbox(
			card
		) {

			gallery =
				getGallery(card);


			if (!gallery.length) {
				return;
			}


			currentIndex = 0;


			const projectTitle =
				card.getAttribute(
					"data-title"
				) || "";


			const projectCategory =
				card.getAttribute(
					"data-category"
				) || "";


			const projectYear =
				card.getAttribute(
					"data-year"
				) || "";


			title.textContent =
				projectTitle;


			meta.textContent =
				`${projectCategory} /${projectYear}`;


			showImage(0);


			modal.classList.add(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"false"
			);


			document.body.style.overflow =
				"hidden";
		}


		/*
		 * ========================================
		 * 關閉 Lightbox
		 * ========================================
		 */

		function closeModal() {

			modal.classList.remove(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"true"
			);


			document.body.style.overflow =
				"";


			setTimeout(
				() => {

					if (
						!modal.classList.contains(
							"active"
						)
					) {

						lightboxImg.src =
							"";

						title.textContent =
							"";

						meta.textContent =
							"";

					}

				},
				300
			);
		}


		/*
		 * ========================================
		 * 首頁作品圖片點擊
		 *
		 * 只有：
		 *
		 * .is-zoom-mode
		 *
		 * 才會進 Lightbox
		 *
		 * mode="page"
		 * 完全不會被攔截
		 * ========================================
		 */

		document.addEventListener(
			"click",
			(event) => {

				const target =
					event.target;


				if (
					!(
						target instanceof
						Element
					)
				) {
					return;
				}


				const card =
					target.closest(
						".product-card.is-zoom-mode[data-zoom-gallery]"
					);


				if (!card) {
					return;
				}


				event.preventDefault();


				openLightbox(
					card
				);
			}
		);


		/*
		 * ========================================
		 * 關閉
		 * ========================================
		 */

		closeBtn.addEventListener(
			"click",
			closeModal
		);


		backdrop.addEventListener(
			"click",
			closeModal
		);


		/*
		 * ========================================
		 * 上一張
		 * ========================================
		 */

		prevBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();

				showImage(
					currentIndex - 1
				);

			}
		);


		/*
		 * ========================================
		 * 下一張
		 * ========================================
		 */

		nextBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();

				showImage(
					currentIndex + 1
				);

			}
		);


		/*
		 * ========================================
		 * ESC / 鍵盤左右鍵
		 * ========================================
		 */

		document.addEventListener(
			"keydown",
			(event) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {
					return;
				}


				if (
					event.key ===
					"Escape"
				) {

					closeModal();

					return;
				}


				if (
					event.key ===
					"ArrowLeft"
				) {

					event.preventDefault();

					showImage(
						currentIndex - 1
					);

					return;
				}


				if (
					event.key ===
					"ArrowRight"
				) {

					event.preventDefault();

					showImage(
						currentIndex + 1
					);

				}

			}
		);


		/*
		 * ========================================
		 * 手機左右滑動
		 * ========================================
		 */

		modal.addEventListener(
			"touchstart",
			(event) => {

				if (
					!event.changedTouches
						.length
				) {
					return;
				}


				touchStartX =
					event
						.changedTouches[0]
						.screenX;

			},
			{
				passive: true,
			}
		);


		modal.addEventListener(
			"touchend",
			(event) => {

				if (
					!event.changedTouches
						.length
				) {
					return;
				}


				const touchEndX =
					event
						.changedTouches[0]
						.screenX;


				const distance =
					touchEndX -
					touchStartX;


				/*
				 * 滑動距離太短
				 * 視為普通觸控
				 */

				if (
					Math.abs(
						distance
					) < 50
				) {
					return;
				}


				if (
					distance < 0
				) {

					showImage(
						currentIndex + 1
					);

				} else {

					showImage(
						currentIndex - 1
					);

				}

			},
			{
				passive: true,
			}
		);

	}


	initLightbox();
</script>


<style>
	/*
	 * ========================================
	 * Grid
	 * ========================================
	 */

	.product-grid {
		position: relative;

		overflow: hidden;

		display: grid;

		width: 100%;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap:
			1rem
			0.2rem;

		margin:
			1rem
			0
			6rem;

		min-height:
			400px;
	}


	.grid-item {
		display: block;

		width: 100%;
	}


	/*
	 * ========================================
	 * Lightbox 外層
	 * ========================================
	 */

	.lightbox {
		position: fixed;

		z-index: 999999;

		inset: 0;

		width: 100%;
		height: 100%;

		background:
			rgba(
				0,
				0,
				0,
				0.92
			);

		display: flex;

		justify-content:
			center;

		align-items:
			center;

		opacity: 0;

		visibility:
			hidden;

		pointer-events:
			none;

		transition:
			opacity
			0.3s ease,

			visibility
			0.3s ease;
	}


	.lightbox.active {
		opacity: 1;

		visibility:
			visible;

		pointer-events:
			auto;
	}


	/*
	 * ========================================
	 * 黑色背景
	 * ========================================
	 */

	.lightbox-backdrop {
		position: absolute;

		inset: 0;

		background:
			rgba(
				0,
				0,
				0,
				0.92
			);
	}


	/*
	 * ========================================
	 * Lightbox 內容
	 * ========================================
	 */

	.lightbox-content {
		position: relative;

		z-index: 2;

		display: flex;

		flex-direction:
			column;

		align-items:
			center;

		justify-content:
			center;

		width:
			min(
				90vw,
				1400px
			);

		height:
			90vh;

		pointer-events:
			none;
	}


	/*
	 * ========================================
	 * 大圖
	 * ========================================
	 */

	.lightbox-content img {
		display: block;

		max-width:
			100%;

		max-height:
			78vh;

		width: auto;

		height: auto;

		object-fit:
			contain;

		user-select:
			none;

		-webkit-user-select:
			none;

		-webkit-user-drag:
			none;

		pointer-events:
			none;
	}


	/*
	 * ========================================
	 * 標題
	 * ========================================
	 */

	.lightbox-title {
		margin-top:
			15px;

		color:
			#ffffff;

		font-size:
			16px;

		font-weight:
			600;

		text-align:
			center;
	}


	/*
	 * ========================================
	 * 類別 / 年份
	 * ========================================
	 */

	.lightbox-meta {
		margin-top:
			5px;

		color:
			#ffffff;

		font-size:
			12px;

		opacity:
			0.6;
	}


	/*
	 * ========================================
	 * 1 / 5
	 * ========================================
	 */

	.lightbox-counter {
		margin-top:
			10px;

		color:
			#ffffff;

		font-size:
			13px;

		opacity:
			0.65;
	}


	/*
	 * ========================================
	 * 按鈕
	 * ========================================
	 */

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;

		z-index: 10;

		border: 0;

		background:
			transparent;

		color:
			#ffffff;

		cursor:
			pointer;

		font-family:
			inherit;

		transition:
			opacity
			0.2s ease,

			transform
			0.2s ease;
	}


	/*
	 * ========================================
	 * 關閉
	 * ========================================
	 */

	.lightbox-close {
		top:
			18px;

		right:
			25px;

		width:
			55px;

		height:
			55px;

		font-size:
			44px;

		font-weight:
			200;

		line-height:
			1;
	}


	/*
	 * ========================================
	 * 左右箭頭
	 * ========================================
	 */

	.lightbox-prev,
	.lightbox-next {
		top:
			50%;

		width:
			70px;

		height:
			90px;

		transform:
			translateY(
				-50%
			);

		font-size:
			42px;

		font-weight:
			200;
	}


	.lightbox-prev {
		left:
			20px;
	}


	.lightbox-next {
		right:
			20px;
	}


	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		opacity:
			0.55;
	}


	.lightbox-prev:hover,
	.lightbox-next:hover {
		transform:
			translateY(
				-50%
			)
			scale(
				1.08
			);
	}


	/*
	 * ========================================
	 * Desktop Grid
	 * ========================================
	 */

	@media screen and (min-width: 64em) {

		.product-grid {
			grid-template-columns:
				repeat(
					5,
					minmax(
						0,
						1fr
					)
				) !important;
		}

	}


	@media screen and (min-width: 80em) {

		.product-grid {
			grid-template-columns:
				repeat(
					6,
					minmax(
						0,
						1fr
					)
				) !important;
		}

	}


	/*
	 * ========================================
	 * Mobile
	 * ========================================
	 */

	@media (max-width: 700px) {

		.lightbox-content {
			width:
				92vw;

			height:
				88vh;
		}


		.lightbox-content img {
			max-width:
				92vw;

			max-height:
				72vh;
		}


		.lightbox-close {
			top:
				8px;

			right:
				10px;

			font-size:
				36px;
		}


		.lightbox-prev,
		.lightbox-next {
			width:
				45px;

			height:
				70px;

			font-size:
				30px;
		}


		.lightbox-prev {
			left:
				0;
		}


		.lightbox-next {
			right:
				0;
		}


		.lightbox-title {
			font-size:
				14px;
		}


		.lightbox-meta {
			font-size:
				11px;
		}


		.lightbox-counter {
			font-size:
				12px;
		}

	}
</style>