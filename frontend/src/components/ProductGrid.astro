---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

type Props = {
  projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;

/*
 * ========================================
 * 作品年份排序
 *
 * 新 → 舊
 * ========================================
 */

const sortedProjects = [...projects].sort(
  (a, b) => b.data.year - a.data.year
);

const grid = "projects";
---

<section
  class="product-grid"
  id="grid"
  data-grid={grid}
>
  {
    sortedProjects.map((project) => {
      const currentCategory =
        project.data.category || "None";

      const imageCrop =
        project.data.imageCrop || "contain";

      const lightboxCaption =
        (project.data as any).lightboxCaption || "";

      const galleryCaptions =
        (project.data as any).galleryCaptions || [];

      return (
        <div
          data-category={currentCategory}
          data-image-crop={imageCrop}
          data-lightbox-caption={lightboxCaption}
          data-gallery-captions={
            JSON.stringify(galleryCaptions)
          }
          class="grid-item"
        >
          <ProductCard product={project} />
        </div>
      );
    })
  }
</section>

<div
  id="lightbox-modal"
  class="lightbox"
  aria-hidden="true"
>
  <div class="lightbox-backdrop"></div>

  <button
    type="button"
    class="lightbox-close"
    aria-label="關閉"
  >
    ×
  </button>

  <button
    type="button"
    class="lightbox-prev"
    aria-label="上一張"
  >
    <span></span>
  </button>

  <div class="lightbox-content">

    <!-- 縮放控制放在圖片上方 -->
    <div
      class="lightbox-zoom-controls"
      aria-label="圖片縮放"
    >
      <button
        type="button"
        class="lightbox-zoom-out"
        aria-label="縮小"
      >
        −
      </button>

      <button
        type="button"
        class="lightbox-zoom-reset"
        aria-label="恢復原始大小"
      >
        100%
      </button>

      <button
        type="button"
        class="lightbox-zoom-in"
        aria-label="放大"
      >
        +
      </button>
    </div>

    <div
      class="lightbox-image-wrap"
      id="lightbox-image-wrap"
    >
      <img
        id="lightbox-img"
        src=""
        alt=""
        draggable="false"
      />

      <!-- 圖片尚未載入時顯示的簡單 loading -->
      <div
        id="lightbox-loading"
        class="lightbox-loading"
        aria-hidden="true"
      ></div>
    </div>

    <div
      class="lightbox-title"
      id="lightbox-title"
    ></div>

    <div
      class="lightbox-meta"
      id="lightbox-meta"
    ></div>

    <div
      class="lightbox-counter"
      id="lightbox-counter"
    >
      1 / 1
    </div>

    <div
      class="lightbox-caption"
      id="lightbox-caption"
    ></div>
  </div>

  <button
    type="button"
    class="lightbox-next"
    aria-label="下一張"
  >
    <span></span>
  </button>
</div>

<script>
  /*
   * ========================================
   * Lightbox
   * ========================================
   */

  type ImageCache = Map<string, HTMLImageElement>;
  type ImagePromiseCache = Map<
    string,
    Promise<HTMLImageElement>
  >;

  /*
   * 將圖片快取掛到 window。
   *
   * 這樣 Astro 頁面切換後，
   * 已經載入過的圖片仍然可以繼續使用。
   */

  type PortfolioWindow = Window & {
    __portfolioLightboxImageCache?: ImageCache;
    __portfolioLightboxImagePromises?: ImagePromiseCache;
  };

  const portfolioWindow =
    window as PortfolioWindow;

  const imageCache: ImageCache =
    portfolioWindow.__portfolioLightboxImageCache ||
    new Map<string, HTMLImageElement>();

  const imagePromiseCache: ImagePromiseCache =
    portfolioWindow.__portfolioLightboxImagePromises ||
    new Map<string, Promise<HTMLImageElement>>();

  portfolioWindow.__portfolioLightboxImageCache =
    imageCache;

  portfolioWindow.__portfolioLightboxImagePromises =
    imagePromiseCache;

  let lightboxInitialized = false;

  /*
   * ========================================
   * 圖片預載入
   * ========================================
   */

  function preloadImage(
    src: string
  ): Promise<HTMLImageElement> {
    if (!src) {
      return Promise.reject(
        new Error("圖片網址不存在")
      );
    }

    /*
     * 已經成功載入
     */
    const cached = imageCache.get(src);

    if (cached && cached.complete) {
      return Promise.resolve(cached);
    }

    /*
     * 已經正在載入
     */
    const existingPromise =
      imagePromiseCache.get(src);

    if (existingPromise) {
      return existingPromise;
    }

    const promise =
      new Promise<HTMLImageElement>(
        (resolve, reject) => {
          const image = new Image();

          image.decoding = "async";

          image.onload = async () => {
            try {
              /*
               * decode 可以讓瀏覽器先完成圖片解碼，
               * 避免已下載但還沒真正繪製時閃一下。
               */
              if (typeof image.decode === "function") {
                try {
                  await image.decode();
                } catch {
                  /*
                   * 某些瀏覽器 decode 可能失敗，
                   * 但圖片其實已經可以使用。
                   */
                }
              }

              imageCache.set(src, image);
              resolve(image);
            } catch (error) {
              reject(error);
            }
          };

          image.onerror = () => {
            imagePromiseCache.delete(src);
            reject(
              new Error(
                `圖片載入失敗：${src}`
              )
            );
          };

          image.src = src;
        }
      );

    imagePromiseCache.set(src, promise);

    return promise;
  }

  /*
   * 取得目前頁面所有 Lightbox 圖片
   */
  function collectLightboxImages(): string[] {
    const cards =
      document.querySelectorAll(
        ".product-card.is-zoom-mode[data-zoom-gallery]"
      );

    const images = new Set<string>();

    cards.forEach((card) => {
      const data =
        card.getAttribute("data-zoom-gallery");

      if (!data) return;

      try {
        const parsed = JSON.parse(data);

        if (!Array.isArray(parsed)) return;

        parsed.forEach((image) => {
          if (
            typeof image === "string" &&
            image.length > 0
          ) {
            images.add(image);
          }
        });
      } catch {
        /*
         * gallery JSON 錯誤時略過
         */
      }
    });

    return [...images];
  }

  /*
   * 背景預載。
   *
   * 不在頁面剛開時一次全部 Promise.all，
   * 避免大量圖片同時搶頻寬。
   */

  function preloadImagesInBackground(
    images: string[]
  ) {
    if (!images.length) return;

    const run = () => {
      let index = 0;

      const loadNext = () => {
        if (index >= images.length) return;

        const src = images[index];
        index += 1;

        preloadImage(src)
          .catch(() => {
            /*
             * 單張失敗不影響其他圖片
             */
          })
          .finally(() => {
            /*
             * 稍微讓瀏覽器喘息，
             * 避免作品集首頁被大量圖片拖慢。
             */
            setTimeout(loadNext, 30);
          });
      };

      /*
       * 一次維持少量載入。
       */
      loadNext();
      setTimeout(loadNext, 80);
      setTimeout(loadNext, 160);
    };

    if ("requestIdleCallback" in window) {
      window.requestIdleCallback(
        run,
        { timeout: 1500 }
      );
    } else {
      setTimeout(run, 500);
    }
  }

  function initLightbox() {
    if (lightboxInitialized) return;

    const modal =
      document.getElementById(
        "lightbox-modal"
      );

    const imageWrap =
      document.getElementById(
        "lightbox-image-wrap"
      );

    const lightboxImg =
      document.getElementById(
        "lightbox-img"
      ) as HTMLImageElement | null;

    const loading =
      document.getElementById(
        "lightbox-loading"
      );

    const title =
      document.getElementById(
        "lightbox-title"
      );

    const meta =
      document.getElementById(
        "lightbox-meta"
      );

    const counter =
      document.getElementById(
        "lightbox-counter"
      );

    const caption =
      document.getElementById(
        "lightbox-caption"
      );

    const closeBtn =
      modal?.querySelector(
        ".lightbox-close"
      );

    const prevBtn =
      modal?.querySelector(
        ".lightbox-prev"
      );

    const nextBtn =
      modal?.querySelector(
        ".lightbox-next"
      );

    const backdrop =
      modal?.querySelector(
        ".lightbox-backdrop"
      );

    const zoomOutBtn =
      modal?.querySelector(
        ".lightbox-zoom-out"
      );

    const zoomResetBtn =
      modal?.querySelector(
        ".lightbox-zoom-reset"
      );

    const zoomInBtn =
      modal?.querySelector(
        ".lightbox-zoom-in"
      );

    if (
      !modal ||
      !imageWrap ||
      !lightboxImg ||
      !loading ||
      !title ||
      !meta ||
      !counter ||
      !caption ||
      !closeBtn ||
      !prevBtn ||
      !nextBtn ||
      !backdrop ||
      !zoomOutBtn ||
      !zoomResetBtn ||
      !zoomInBtn
    ) {
      return;
    }

    lightboxInitialized = true;

    let gallery: string[] = [];
    let galleryCaptions: string[] = [];
    let projectCaption = "";
    let currentIndex = 0;

    let currentCrop:
      | "contain"
      | "square" = "contain";

    /*
     * ========================================
     * Zoom
     * ========================================
     */

    let zoomLevel = 1;

    const MIN_ZOOM = 1;
    const MAX_ZOOM = 3;
    const ZOOM_STEP = 0.25;

    let translateX = 0;
    let translateY = 0;

    let isDragging = false;

    let dragStartX = 0;
    let dragStartY = 0;

    let dragOriginX = 0;
    let dragOriginY = 0;

    let touchStartX = 0;
    let touchStartY = 0;

    /*
     * 防止快速切換圖片時，
     * 前一張圖片晚到而覆蓋目前圖片。
     */
    let imageRequestId = 0;

    /*
     * ========================================
     * Gallery
     * ========================================
     */

    function getGallery(card: Element) {
      const galleryData =
        card.getAttribute(
          "data-zoom-gallery"
        );

      if (!galleryData) return [];

      try {
        const images =
          JSON.parse(galleryData);

        if (!Array.isArray(images)) {
          return [];
        }

        return images.filter(
          (image) =>
            typeof image === "string" &&
            image.length > 0
        );
      } catch (error) {
        console.warn(
          "Lightbox gallery 讀取失敗：",
          error
        );

        return [];
      }
    }

    function getGalleryCaptions(
      wrapper: Element
    ): string[] {
      const data =
        wrapper.getAttribute(
          "data-gallery-captions"
        );

      if (!data) return [];

      try {
        const parsed = JSON.parse(data);

        if (!Array.isArray(parsed)) {
          return [];
        }

        return parsed.map((item) =>
          typeof item === "string"
            ? item
            : ""
        );
      } catch (error) {
        console.warn(
          "Lightbox captions 讀取失敗：",
          error
        );

        return [];
      }
    }

    /*
     * ========================================
     * Zoom reset
     * ========================================
     */

    function resetZoom() {
      zoomLevel = 1;

      translateX = 0;
      translateY = 0;

      lightboxImg.style.transform =
        "translate3d(0, 0, 0) scale(1)";

      lightboxImg.classList.remove(
        "is-zoomed"
      );

      lightboxImg.classList.remove(
        "is-dragging"
      );

      zoomResetBtn.textContent = "100%";
    }

    function updateZoom() {
      zoomLevel = Math.max(
        MIN_ZOOM,
        Math.min(MAX_ZOOM, zoomLevel)
      );

      if (zoomLevel <= 1) {
        translateX = 0;
        translateY = 0;
      }

      lightboxImg.style.transform =
        `translate3d(${translateX}px, ${translateY}px, 0) scale(${zoomLevel})`;

      if (zoomLevel > 1) {
        lightboxImg.classList.add(
          "is-zoomed"
        );
      } else {
        lightboxImg.classList.remove(
          "is-zoomed"
        );
      }

      zoomResetBtn.textContent =
        `${Math.round(zoomLevel * 100)}%`;
    }

    function setZoom(value: number) {
      zoomLevel = value;
      updateZoom();
    }

    function zoomIn() {
      setZoom(
        zoomLevel + ZOOM_STEP
      );
    }

    function zoomOut() {
      setZoom(
        zoomLevel - ZOOM_STEP
      );
    }

    /*
     * ========================================
     * 顯示圖片
     * ========================================
     */

    async function showImage(
      index: number
    ) {
      if (!gallery.length) return;

      if (index < 0) {
        index = gallery.length - 1;
      }

      if (index >= gallery.length) {
        index = 0;
      }

      currentIndex = index;

      const image =
        gallery[currentIndex];

      const requestId =
        ++imageRequestId;

      resetZoom();

      /*
       * 圖片尚未完成前完全隱藏。
       *
       * 這就是修正「點開瞬間破圖」的關鍵。
       */
      lightboxImg.classList.remove(
        "is-loaded"
      );

      lightboxImg.classList.add(
        "is-loading"
      );

      loading.classList.add(
        "active"
      );

      /*
       * 先清掉舊圖片，
       * 避免 square 模式下舊圖短暫殘留。
       */
      lightboxImg.removeAttribute(
        "src"
      );

      counter.textContent =
        `${currentIndex + 1} / ${gallery.length}`;

      const individualCaption =
        galleryCaptions[currentIndex] ||
        "";

      const finalCaption =
        individualCaption ||
        projectCaption ||
        "";

      caption.textContent =
        finalCaption;

      if (finalCaption) {
        caption.classList.add(
          "has-caption"
        );
      } else {
        caption.classList.remove(
          "has-caption"
        );
      }

      /*
       * 預先載入目前圖片
       */
      try {
        const cached =
          imageCache.get(image);

        let loadedImage:
          | HTMLImageElement
          | undefined;

        if (
          cached &&
          cached.complete
        ) {
          loadedImage = cached;
        } else {
          loadedImage =
            await preloadImage(image);
        }

        /*
         * 如果使用者在圖片載入期間
         * 已經切到下一張，
         * 就不要把這張舊圖片放回去。
         */
        if (
          requestId !== imageRequestId
        ) {
          return;
        }

        /*
         * 使用已完成載入的圖片。
         */
        lightboxImg.src =
          loadedImage.src;

        lightboxImg.alt =
          title.textContent || "";

        /*
         * 等瀏覽器完成實際繪製。
         */
        requestAnimationFrame(() => {
          if (
            requestId !== imageRequestId
          ) {
            return;
          }

          lightboxImg.classList.remove(
            "is-loading"
          );

          lightboxImg.classList.add(
            "is-loaded"
          );

          loading.classList.remove(
            "active"
          );
        });
      } catch (error) {
        if (
          requestId !== imageRequestId
        ) {
          return;
        }

        lightboxImg.classList.remove(
          "is-loading"
        );

        loading.classList.remove(
          "active"
        );

        console.warn(
          "Lightbox 圖片載入失敗：",
          image,
          error
        );
      }

      /*
       * ========================================
       * 提前載入前後圖片
       * ========================================
       */

      if (gallery.length > 1) {
        const previousIndex =
          currentIndex - 1 < 0
            ? gallery.length - 1
            : currentIndex - 1;

        const nextIndex =
          currentIndex + 1 >=
          gallery.length
            ? 0
            : currentIndex + 1;

        preloadImage(
          gallery[previousIndex]
        ).catch(() => {});

        preloadImage(
          gallery[nextIndex]
        ).catch(() => {});
      }
    }

    /*
     * ========================================
     * 開啟
     * ========================================
     */

    function openLightbox(
      card: Element
    ) {
      const wrapper =
        card.closest(".grid-item");

      if (!wrapper) return;

      gallery =
        getGallery(card);

      if (!gallery.length) {
        console.warn(
          "Lightbox 沒有找到圖片：",
          card
        );

        return;
      }

      const crop =
        wrapper.getAttribute(
          "data-image-crop"
        );

      currentCrop =
        crop === "square"
          ? "square"
          : "contain";

      projectCaption =
        wrapper.getAttribute(
          "data-lightbox-caption"
        ) || "";

      galleryCaptions =
        getGalleryCaptions(
          wrapper
        );

      /*
       * Square 模式
       */
      if (
        currentCrop === "square"
      ) {
        imageWrap.classList.add(
          "is-square"
        );
      } else {
        imageWrap.classList.remove(
          "is-square"
        );
      }

      const projectTitle =
        card.getAttribute(
          "data-title"
        ) || "";

      const projectCategory =
        card.getAttribute(
          "data-category"
        ) || "";

      const projectYear =
        card.getAttribute(
          "data-year"
        ) || "";

      title.textContent =
        projectTitle;

      meta.textContent =
        `${projectCategory} / ${projectYear}`;

      currentIndex = 0;

      /*
       * 先打開 Lightbox。
       * 圖片本身仍然保持隱藏，
       * 所以不會看到破圖。
       */
      modal.classList.add(
        "active"
      );

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow =
        "hidden";

      /*
       * 立即載入第一張。
       */
      showImage(0);

      /*
       * 目前 gallery 的前兩張優先預載。
       */
      gallery
        .slice(0, 3)
        .forEach((image) => {
          preloadImage(image).catch(
            () => {}
          );
        });
    }

    /*
     * ========================================
     * 關閉
     * ========================================
     */

    function closeModal() {
      imageRequestId += 1;

      modal.classList.remove(
        "active"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        "";

      resetZoom();

      lightboxImg.classList.remove(
        "is-loaded"
      );

      lightboxImg.classList.add(
        "is-loading"
      );

      loading.classList.remove(
        "active"
      );

      setTimeout(() => {
        if (
          !modal.classList.contains(
            "active"
          )
        ) {
          lightboxImg.removeAttribute(
            "src"
          );

          title.textContent = "";
          meta.textContent = "";

          counter.textContent =
            "1 / 1";

          caption.textContent = "";

          caption.classList.remove(
            "has-caption"
          );

          gallery = [];
          galleryCaptions = [];
          projectCaption = "";
        }
      }, 300);
    }

    /*
     * ========================================
     * Card click
     * ========================================
     */

    const handleCardClick = (
      event: Event
    ) => {
      const target =
        event.target;

      if (
        !(target instanceof Element)
      ) {
        return;
      }

      const card =
        target.closest(
          ".product-card.is-zoom-mode[data-zoom-gallery]"
        );

      if (!card) return;

      const interactive =
        target.closest(
          "a, button"
        );

      if (
        interactive &&
        interactive !== card
      ) {
        if (
          interactive.matches(
            ".product-card"
          )
        ) {
          event.preventDefault();
        } else {
          return;
        }
      }

      event.preventDefault();

      openLightbox(card);
    };

    document.addEventListener(
      "click",
      handleCardClick
    );

    /*
     * ========================================
     * Buttons
     * ========================================
     */

    closeBtn.addEventListener(
      "click",
      closeModal
    );

    backdrop.addEventListener(
      "click",
      closeModal
    );

    prevBtn.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        showImage(
          currentIndex - 1
        );
      }
    );

    nextBtn.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        showImage(
          currentIndex + 1
        );
      }
    );

    zoomInBtn.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        zoomIn();
      }
    );

    zoomOutBtn.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        zoomOut();
      }
    );

    zoomResetBtn.addEventListener(
      "click",
      (event) => {
        event.stopPropagation();

        setZoom(1);
      }
    );

    /*
     * ========================================
     * 滾輪縮放
     * ========================================
     */

    imageWrap.addEventListener(
      "wheel",
      (event) => {
        if (
          !modal.classList.contains(
            "active"
          )
        ) {
          return;
        }

        event.preventDefault();

        if (event.deltaY < 0) {
          zoomIn();
        } else {
          zoomOut();
        }
      },
      { passive: false }
    );

    /*
     * ========================================
     * 雙擊縮放
     * ========================================
     */

    lightboxImg.addEventListener(
      "dblclick",
      (event) => {
        event.preventDefault();

        if (zoomLevel > 1) {
          setZoom(1);
        } else {
          setZoom(2);
        }
      }
    );

    /*
     * ========================================
     * 滑鼠拖曳
     * ========================================
     */

    lightboxImg.addEventListener(
      "mousedown",
      (event) => {
        if (zoomLevel <= 1) return;

        event.preventDefault();

        isDragging = true;

        dragStartX =
          event.clientX;

        dragStartY =
          event.clientY;

        dragOriginX =
          translateX;

        dragOriginY =
          translateY;

        lightboxImg.classList.add(
          "is-dragging"
        );
      }
    );

    window.addEventListener(
      "mousemove",
      (event) => {
        if (!isDragging) return;

        translateX =
          dragOriginX +
          (event.clientX -
            dragStartX);

        translateY =
          dragOriginY +
          (event.clientY -
            dragStartY);

        updateZoom();
      }
    );

    window.addEventListener(
      "mouseup",
      () => {
        if (!isDragging) return;

        isDragging = false;

        lightboxImg.classList.remove(
          "is-dragging"
        );
      }
    );

    /*
     * ========================================
     * 鍵盤
     * ========================================
     */

    const handleKeydown = (
      event: KeyboardEvent
    ) => {
      if (
        !modal.classList.contains(
          "active"
        )
      ) {
        return;
      }

      if (event.key === "Escape") {
        closeModal();
        return;
      }

      if (
        event.key === "+" ||
        event.key === "="
      ) {
        event.preventDefault();

        zoomIn();

        return;
      }

      if (event.key === "-") {
        event.preventDefault();

        zoomOut();

        return;
      }

      if (event.key === "0") {
        event.preventDefault();

        setZoom(1);

        return;
      }

      if (
        event.key === "ArrowLeft"
      ) {
        event.preventDefault();

        showImage(
          currentIndex - 1
        );

        return;
      }

      if (
        event.key === "ArrowRight"
      ) {
        event.preventDefault();

        showImage(
          currentIndex + 1
        );
      }
    };

    document.addEventListener(
      "keydown",
      handleKeydown
    );

    /*
     * ========================================
     * 手機滑動
     * ========================================
     */

    const handleTouchStart = (
      event: TouchEvent
    ) => {
      if (
        !event.changedTouches ||
        !event.changedTouches.length
      ) {
        return;
      }

      touchStartX =
        event.changedTouches[0]
          .screenX;

      touchStartY =
        event.changedTouches[0]
          .screenY;
    };

    const handleTouchEnd = (
      event: TouchEvent
    ) => {
      if (
        !event.changedTouches ||
        !event.changedTouches.length
      ) {
        return;
      }

      const touchEndX =
        event.changedTouches[0]
          .screenX;

      const touchEndY =
        event.changedTouches[0]
          .screenY;

      const distanceX =
        touchEndX -
        touchStartX;

      const distanceY =
        touchEndY -
        touchStartY;

      if (zoomLevel > 1) {
        if (
          Math.abs(distanceX) <
          100
        ) {
          return;
        }

        if (
          Math.abs(distanceY) >
          Math.abs(distanceX)
        ) {
          return;
        }
      }

      if (
        Math.abs(distanceX) <
        50
      ) {
        return;
      }

      if (distanceX < 0) {
        showImage(
          currentIndex + 1
        );
      } else {
        showImage(
          currentIndex - 1
        );
      }
    };

    modal.addEventListener(
      "touchstart",
      handleTouchStart,
      { passive: true }
    );

    modal.addEventListener(
      "touchend",
      handleTouchEnd,
      { passive: true }
    );

    /*
     * ========================================
     * 頁面初始化後，
     * 背景慢慢預載 Lightbox 圖片
     * ========================================
     */

    const backgroundImages =
      collectLightboxImages();

    preloadImagesInBackground(
      backgroundImages
    );
  }

  /*
   * ========================================
   * 初始化
   * ========================================
   */

  if (
    document.readyState ===
    "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initLightbox,
      { once: true }
    );
  } else {
    initLightbox();
  }

  /*
   * Astro View Transition
   */
  document.addEventListener(
    "astro:after-swap",
    () => {
      lightboxInitialized = false;

      initLightbox();
    }
  );
</script>

