---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;


/*
 * ========================================
 * 作品年份排序
 * 新 → 舊
 * ========================================
 */

const sortedProjects = [
	...projects,
].sort(
	(a, b) =>
		b.data.year - a.data.year
);


const grid = "projects";
---


<section
	class="product-grid"
	id="grid"
	data-grid={grid}
>
	{
		sortedProjects.map((project) => {
			const currentCategory =
				project.data.category || "None";

			const imageCrop =
				project.data.imageCrop || "contain";

			const lightboxCaption =
				(project.data as any).lightboxCaption || "";

			const galleryCaptions =
				(project.data as any).galleryCaptions || [];


			return (
				<div
					data-category={currentCategory}
					data-image-crop={imageCrop}
					data-lightbox-caption={lightboxCaption}
					data-gallery-captions={
						JSON.stringify(galleryCaptions)
					}
					class="grid-item"
				>
					<ProductCard
						product={project}
					/>
				</div>
			);
		})
	}
</section>


<!-- ========================================
     首頁 Lightbox
     ======================================== -->

<div
	id="lightbox-modal"
	class="lightbox"
	aria-hidden="true"
>
	<div
		class="lightbox-backdrop"
	></div>


	<button
		type="button"
		class="lightbox-close"
		aria-label="關閉"
	>
		×
	</button>


	<button
		type="button"
		class="lightbox-prev"
		aria-label="上一張"
	>
		<span></span>
	</button>


	<div class="lightbox-content">

		<!-- ====================================
		     Zoom 控制
		     現在固定放在圖片上方
		     ==================================== -->

		<div
			class="lightbox-zoom-controls"
			aria-label="圖片縮放"
		>

			<button
				type="button"
				class="lightbox-zoom-out"
				aria-label="縮小"
			>
				−
			</button>


			<button
				type="button"
				class="lightbox-zoom-reset"
				aria-label="恢復原始大小"
			>
				100%
			</button>


			<button
				type="button"
				class="lightbox-zoom-in"
				aria-label="放大"
			>
				+
			</button>

		</div>


		<!-- ====================================
		     圖片
		     ==================================== -->

		<div
			class="lightbox-image-wrap"
			id="lightbox-image-wrap"
		>

			<img
				id="lightbox-img"
				src=""
				alt=""
				draggable="false"
			/>

		</div>


		<div
			class="lightbox-title"
			id="lightbox-title"
		></div>


		<div
			class="lightbox-meta"
			id="lightbox-meta"
		></div>


		<div
			class="lightbox-counter"
			id="lightbox-counter"
		>
			1 / 1
		</div>


		<div
			class="lightbox-caption"
			id="lightbox-caption"
		></div>

	</div>


	<button
		type="button"
		class="lightbox-next"
		aria-label="下一張"
	>
		<span></span>
	</button>
</div>


<script>
	let lightboxInitialized = false;


	function initLightbox() {

		if (lightboxInitialized) {
			return;
		}


		/*
		 * ========================================
		 * DOM
		 * ========================================
		 */

		const modal =
			document.getElementById(
				"lightbox-modal"
			);


		const imageWrap =
			document.getElementById(
				"lightbox-image-wrap"
			);


		const lightboxImg =
			document.getElementById(
				"lightbox-img"
			);


		const title =
			document.getElementById(
				"lightbox-title"
			);


		const meta =
			document.getElementById(
				"lightbox-meta"
			);


		const counter =
			document.getElementById(
				"lightbox-counter"
			);


		const caption =
			document.getElementById(
				"lightbox-caption"
			);


		const closeBtn =
			modal?.querySelector(
				".lightbox-close"
			);


		const prevBtn =
			modal?.querySelector(
				".lightbox-prev"
			);


		const nextBtn =
			modal?.querySelector(
				".lightbox-next"
			);


		const backdrop =
			modal?.querySelector(
				".lightbox-backdrop"
			);


		const zoomOutBtn =
			modal?.querySelector(
				".lightbox-zoom-out"
			);


		const zoomResetBtn =
			modal?.querySelector(
				".lightbox-zoom-reset"
			);


		const zoomInBtn =
			modal?.querySelector(
				".lightbox-zoom-in"
			);


		if (
			!modal ||
			!imageWrap ||
			!lightboxImg ||
			!title ||
			!meta ||
			!counter ||
			!caption ||
			!closeBtn ||
			!prevBtn ||
			!nextBtn ||
			!backdrop ||
			!zoomOutBtn ||
			!zoomResetBtn ||
			!zoomInBtn
		) {
			return;
		}


		lightboxInitialized = true;


		/*
		 * ========================================
		 * Lightbox 狀態
		 * ========================================
		 */

		let gallery: string[] = [];

		let galleryCaptions: string[] = [];

		let projectCaption = "";

		let currentIndex = 0;

		let currentCrop:
			"contain" | "square" = "contain";


		/*
		 * ========================================
		 * Zoom 狀態
		 * ========================================
		 */

		let zoomLevel = 1;

		const MIN_ZOOM = 1;

		const MAX_ZOOM = 3;

		const ZOOM_STEP = 0.25;


		let translateX = 0;

		let translateY = 0;


		let isDragging = false;

		let dragStartX = 0;

		let dragStartY = 0;

		let dragOriginX = 0;

		let dragOriginY = 0;


		let touchStartX = 0;

		let touchStartY = 0;


		/*
		 * ========================================
		 * Gallery
		 * ========================================
		 */

		function getGallery(card: Element) {

			const galleryData =
				card.getAttribute(
					"data-zoom-gallery"
				);


			if (!galleryData) {
				return [];
			}


			try {

				const images =
					JSON.parse(
						galleryData
					);


				if (
					!Array.isArray(images)
				) {
					return [];
				}


				return images.filter(
					(image) =>
						typeof image ===
							"string" &&
						image.length > 0
				);

			} catch (error) {

				console.warn(
					"Lightbox gallery 讀取失敗：",
					error
				);


				return [];
			}
		}


		/*
		 * ========================================
		 * Gallery Captions
		 * ========================================
		 */

		function getGalleryCaptions(
			wrapper: Element
		): string[] {

			const data =
				wrapper.getAttribute(
					"data-gallery-captions"
				);


			if (!data) {
				return [];
			}


			try {

				const parsed =
					JSON.parse(data);


				if (
					!Array.isArray(parsed)
				) {
					return [];
				}


				return parsed.map(
					(item) =>
						typeof item === "string"
							? item
							: ""
				);

			} catch (error) {

				console.warn(
					"Lightbox captions 讀取失敗：",
					error
				);


				return [];
			}
		}


		/*
		 * ========================================
		 * Reset Zoom
		 * ========================================
		 */

		function resetZoom() {

			zoomLevel = 1;

			translateX = 0;

			translateY = 0;


			lightboxImg.style.transform =
				"translate3d(0, 0, 0) scale(1)";


			lightboxImg.classList.remove(
				"is-zoomed"
			);


			zoomResetBtn.textContent =
				"100%";
		}


		/*
		 * ========================================
		 * Update Zoom
		 * ========================================
		 */

		function updateZoom() {

			zoomLevel =
				Math.max(
					MIN_ZOOM,
					Math.min(
						MAX_ZOOM,
						zoomLevel
					)
				);


			if (zoomLevel <= 1) {

				translateX = 0;

				translateY = 0;
			}


			lightboxImg.style.transform =
				`translate3d(
					${translateX}px,
					${translateY}px,
					0
				)
				scale(${zoomLevel})`;


			if (zoomLevel > 1) {

				lightboxImg.classList.add(
					"is-zoomed"
				);

			} else {

				lightboxImg.classList.remove(
					"is-zoomed"
				);
			}


			zoomResetBtn.textContent =
				`${Math.round(
					zoomLevel * 100
				)}%`;
		}


		function setZoom(
			value: number
		) {

			zoomLevel = value;

			updateZoom();
		}


		function zoomIn() {

			setZoom(
				zoomLevel +
				ZOOM_STEP
			);
		}


		function zoomOut() {

			setZoom(
				zoomLevel -
				ZOOM_STEP
			);
		}


		/*
		 * ========================================
		 * 顯示圖片
		 * ========================================
		 */

		function showImage(
			index: number
		) {

			if (!gallery.length) {
				return;
			}


			if (index < 0) {

				index =
					gallery.length - 1;
			}


			if (
				index >=
				gallery.length
			) {

				index = 0;
			}


			currentIndex = index;


			const image =
				gallery[
					currentIndex
				];


			resetZoom();


			lightboxImg.onerror =
				null;


			lightboxImg.classList.add(
				"is-loading"
			);


			lightboxImg.src =
				image;


			counter.textContent =
				`${currentIndex + 1} / ${gallery.length}`;


			const individualCaption =
				galleryCaptions[
					currentIndex
				] || "";


			const finalCaption =
				individualCaption ||
				projectCaption ||
				"";


			caption.textContent =
				finalCaption;


			if (finalCaption) {

				caption.classList.add(
					"has-caption"
				);

			} else {

				caption.classList.remove(
					"has-caption"
				);
			}


			lightboxImg.onload =
				() => {

					lightboxImg.classList.remove(
						"is-loading"
					);
				};


			lightboxImg.onerror =
				() => {

					lightboxImg.classList.remove(
						"is-loading"
					);

					console.warn(
						"Lightbox 圖片載入失敗：",
						image
					);
				};
		}


		/*
		 * ========================================
		 * 開啟 Lightbox
		 * ========================================
		 */

		function openLightbox(
			card: Element
		) {

			const wrapper =
				card.closest(
					".grid-item"
				);


			if (!wrapper) {
				return;
			}


			gallery =
				getGallery(card);


			if (!gallery.length) {

				console.warn(
					"Lightbox 沒有找到圖片：",
					card
				);

				return;
			}


			const crop =
				wrapper.getAttribute(
					"data-image-crop"
				);


			currentCrop =
				crop === "square"
					? "square"
					: "contain";


			projectCaption =
				wrapper.getAttribute(
					"data-lightbox-caption"
				) || "";


			galleryCaptions =
				getGalleryCaptions(
					wrapper
				);


			if (
				currentCrop === "square"
			) {

				imageWrap.classList.add(
					"is-square"
				);

			} else {

				imageWrap.classList.remove(
					"is-square"
				);
			}


			const projectTitle =
				card.getAttribute(
					"data-title"
				) || "";


			const projectCategory =
				card.getAttribute(
					"data-category"
				) || "";


			const projectYear =
				card.getAttribute(
					"data-year"
				) || "";


			title.textContent =
				projectTitle;


			meta.textContent =
				`${projectCategory} / ${projectYear}`;


			currentIndex = 0;

			showImage(0);


			modal.classList.add(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"false"
			);


			document.body.style.overflow =
				"hidden";
		}


		/*
		 * ========================================
		 * 關閉 Lightbox
		 * ========================================
		 */

		function closeModal() {

			modal.classList.remove(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"true"
			);


			document.body.style.overflow =
				"";


			resetZoom();


			setTimeout(
				() => {

					if (
						!modal.classList.contains(
							"active"
						)
					) {

						lightboxImg.src =
							"";


						title.textContent =
							"";


						meta.textContent =
							"";


						counter.textContent =
							"1 / 1";


						caption.textContent =
							"";


						caption.classList.remove(
							"has-caption"
						);


						gallery = [];

						galleryCaptions = [];

						projectCaption = "";
					}

				},
				300
			);
		}


		/*
		 * ========================================
		 * 點擊作品
		 * ========================================
		 */

		const handleCardClick =
			(event: Event) => {

				const target =
					event.target;


				if (
					!(
						target instanceof
						Element
					)
				) {
					return;
				}


				const card =
					target.closest(
						".product-card.is-zoom-mode[data-zoom-gallery]"
					);


				if (!card) {
					return;
				}


				const interactive =
					target.closest(
						"a, button"
					);


				if (
					interactive &&
					interactive !== card
				) {

					if (
						interactive.matches(
							".product-card"
						)
					) {

						event.preventDefault();

					} else {

						return;
					}
				}


				event.preventDefault();


				openLightbox(
					card
				);
			};


		document.addEventListener(
			"click",
			handleCardClick
		);


		/*
		 * ========================================
		 * 關閉
		 * ========================================
		 */

		closeBtn.addEventListener(
			"click",
			closeModal
		);


		backdrop.addEventListener(
			"click",
			closeModal
		);


		/*
		 * ========================================
		 * 上一張
		 * ========================================
		 */

		prevBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				showImage(
					currentIndex - 1
				);
			}
		);


		/*
		 * ========================================
		 * 下一張
		 * ========================================
		 */

		nextBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				showImage(
					currentIndex + 1
				);
			}
		);


		/*
		 * ========================================
		 * Zoom Buttons
		 * ========================================
		 */

		zoomInBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();

				zoomIn();
			}
		);


		zoomOutBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();

				zoomOut();
			}
		);


		zoomResetBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();

				setZoom(1);
			}
		);


		/*
		 * ========================================
		 * 滑鼠滾輪縮放
		 * ========================================
		 */

		imageWrap.addEventListener(
			"wheel",
			(event) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {
					return;
				}


				event.preventDefault();


				if (event.deltaY < 0) {

					zoomIn();

				} else {

					zoomOut();
				}
			},
			{
				passive: false,
			}
		);


		/*
		 * ========================================
		 * 雙擊縮放
		 * ========================================
		 */

		lightboxImg.addEventListener(
			"dblclick",
			(event) => {

				event.preventDefault();


				if (zoomLevel > 1) {

					setZoom(1);

				} else {

					setZoom(2);
				}
			}
		);


		/*
		 * ========================================
		 * 滑鼠拖曳
		 * ========================================
		 */

		lightboxImg.addEventListener(
			"mousedown",
			(event) => {

				if (
					zoomLevel <= 1
				) {
					return;
				}


				event.preventDefault();


				isDragging = true;


				dragStartX =
					event.clientX;


				dragStartY =
					event.clientY;


				dragOriginX =
					translateX;


				dragOriginY =
					translateY;


				lightboxImg.classList.add(
					"is-dragging"
				);
			}
		);


		window.addEventListener(
			"mousemove",
			(event) => {

				if (!isDragging) {
					return;
				}


				translateX =
					dragOriginX +
					(
						event.clientX -
						dragStartX
					);


				translateY =
					dragOriginY +
					(
						event.clientY -
						dragStartY
					);


				updateZoom();
			}
		);


		window.addEventListener(
			"mouseup",
			() => {

				if (!isDragging) {
					return;
				}


				isDragging = false;


				lightboxImg.classList.remove(
					"is-dragging"
				);
			}
		);


		/*
		 * ========================================
		 * ESC / 鍵盤
		 * ========================================
		 */

		const handleKeydown =
			(event: KeyboardEvent) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {
					return;
				}


				if (
					event.key ===
					"Escape"
				) {

					closeModal();

					return;
				}


				if (
					event.key ===
					"+" ||
					event.key ===
					"="
				) {

					event.preventDefault();

					zoomIn();

					return;
				}


				if (
					event.key ===
					"-"
				) {

					event.preventDefault();

					zoomOut();

					return;
				}


				if (
					event.key ===
					"0"
				) {

					event.preventDefault();

					setZoom(1);

					return;
				}


				if (
					event.key ===
					"ArrowLeft"
				) {

					event.preventDefault();


					showImage(
						currentIndex - 1
					);


					return;
				}


				if (
					event.key ===
					"ArrowRight"
				) {

					event.preventDefault();


					showImage(
						currentIndex + 1
					);
				}
			};


		document.addEventListener(
			"keydown",
			handleKeydown
		);


		/*
		 * ========================================
		 * Touch Start
		 * ========================================
		 */

		const handleTouchStart =
			(event: TouchEvent) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {
					return;
				}


				touchStartX =
					event
						.changedTouches[0]
						.screenX;


				touchStartY =
					event
						.changedTouches[0]
						.screenY;
			};


		/*
		 * ========================================
		 * Touch End
		 * ========================================
		 */

		const handleTouchEnd =
			(event: TouchEvent) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {
					return;
				}


				const touchEndX =
					event
						.changedTouches[0]
						.screenX;


				const touchEndY =
					event
						.changedTouches[0]
						.screenY;


				const distanceX =
					touchEndX -
					touchStartX;


				const distanceY =
					touchEndY -
					touchStartY;


				if (
					zoomLevel > 1
				) {

					if (
						Math.abs(
							distanceX
						) < 100
					) {
						return;
					}


					if (
						Math.abs(
							distanceY
						) >
						Math.abs(
							distanceX
						)
					) {
						return;
					}
				}


				if (
					Math.abs(
						distanceX
					) < 50
				) {
					return;
				}


				if (
					distanceX < 0
				) {

					showImage(
						currentIndex + 1
					);

				} else {

					showImage(
						currentIndex - 1
					);
				}
			};


		modal.addEventListener(
			"touchstart",
			handleTouchStart,
			{
				passive: true,
			}
		);


		modal.addEventListener(
			"touchend",
			handleTouchEnd,
			{
				passive: true,
			}
		);

	}


	/*
	 * ========================================
	 * 初次載入
	 * ========================================
	 */

	if (
		document.readyState ===
		"loading"
	) {

		document.addEventListener(
			"DOMContentLoaded",
			initLightbox,
			{
				once: true,
			}
		);

	} else {

		initLightbox();

	}


	/*
	 * ========================================
	 * Astro View Transitions
	 * ========================================
	 */

	document.addEventListener(
		"astro:after-swap",
		() => {

			lightboxInitialized =
				false;


			initLightbox();

		}
	);
</script>


<style>

	/*
	 * ========================================
	 * Grid
	 * ========================================
	 */

	.product-grid {
		position: relative;

		overflow: hidden;

		display: grid;

		width: 100%;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap:
			1rem
			0.2rem;

		margin:
			1rem
			0
			6rem;

		min-height:
			400px;
	}


	.grid-item {
		display: block;

		width: 100%;
	}


	/*
	 * ========================================
	 * Lightbox 外層
	 * ========================================
	 */

	.lightbox {
