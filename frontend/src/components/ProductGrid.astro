---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;


/*
 * ========================================
 * 作品排序
 *
 * 第一層：
 * Product → Visual → Graphic
 *
 * 第二層：
 * 同分類內年份 新 → 舊
 *
 * 其他分類放最後
 * ========================================
 */

const categoryOrder: Record<string, number> = {
	Product: 0,
	Visual: 1,
	Graphic: 2,
};

const sortedProjects = [...projects].sort(
	(a, b) => {
		const categoryA =
			categoryOrder[a.data.category || ""] ??
			99;

		const categoryB =
			categoryOrder[b.data.category || ""] ??
			99;

		if (categoryA !== categoryB) {
			return categoryA - categoryB;
		}

		const yearA =
			Number(a.data.year) || 0;

		const yearB =
			Number(b.data.year) || 0;

		return yearB - yearA;
	}
);

const grid = "projects";
---


<section
	class="product-grid"
	id="grid"
	data-grid={grid}
>
	{
		sortedProjects.map(
			(project) => {

				const currentCategory =
					project.data.category ||
					"None";

				const imageCrop =
					project.data.imageCrop ||
					"contain";

				const lightboxCaption =
					(project.data as any)
						.lightboxCaption ||
					"";

				const galleryCaptions =
					(project.data as any)
						.galleryCaptions ||
					[];

				return (
					<div
						data-category={
							currentCategory
						}

						data-image-crop={
							imageCrop
						}

						data-lightbox-caption={
							lightboxCaption
						}

						data-gallery-captions={
							JSON.stringify(
								galleryCaptions
							)
						}

						class="grid-item"
					>
						<ProductCard
							product={project}
						/>
					</div>
				);
			}
		)
	}
</section>


<div
	id="lightbox-modal"
	class="lightbox"
	aria-hidden="true"
>
	<div class="lightbox-backdrop"></div>


	<button
		type="button"
		class="lightbox-close"
		aria-label="關閉"
	>
		×
	</button>


	<button
		type="button"
		class="lightbox-prev"
		aria-label="上一張"
	>
		<span></span>
	</button>


	<div class="lightbox-content">

		<!-- ========================================
		     1. 圖片
		     ======================================== -->

		<div
			class="lightbox-image-wrap"
			id="lightbox-image-wrap"
		>
			<img
				id="lightbox-img"
				src=""
				alt=""
				draggable="false"
			/>

			<div
				id="lightbox-loading"
				class="lightbox-loading"
				aria-hidden="true"
			></div>
		</div>


		<!-- ========================================
		     2. 作品名 + 分類 / 年份
		     ======================================== -->

		<div
			class="lightbox-project-info"
		>
			<div
				class="lightbox-title"
				id="lightbox-title"
			></div>

			<div
				class="lightbox-meta"
				id="lightbox-meta"
			></div>
		</div>


		<!-- ========================================
		     3. 頁數
		     ======================================== -->

		<div
			class="lightbox-counter"
			id="lightbox-counter"
		>
			1 / 1
		</div>


		<!-- ========================================
		     4. 文字說明
		     ======================================== -->

		<div
			class="lightbox-caption"
			id="lightbox-caption"
		></div>

	</div>


	<button
		type="button"
		class="lightbox-next"
		aria-label="下一張"
	>
		<span></span>
	</button>

</div>


<script>

	/*
	 * ========================================
	 * Lightbox
	 * ========================================
	 */


	type ImageCache =
		Map<
			string,
			HTMLImageElement
		>;


	type ImagePromiseCache =
		Map<
			string,
			Promise<HTMLImageElement>
		>;


	/*
	 * ========================================
	 * Window Cache
	 *
	 * Astro 頁面切換後，
	 * 已經載入過的圖片仍可重複使用。
	 * ========================================
	 */

	type PortfolioWindow =
		Window & {
			__portfolioLightboxImageCache?:
				ImageCache;

			__portfolioLightboxImagePromises?:
				ImagePromiseCache;
		};


	const portfolioWindow =
		window as PortfolioWindow;


	const imageCache:
		ImageCache =
		portfolioWindow
			.__portfolioLightboxImageCache ||
		new Map<
			string,
			HTMLImageElement
		>();


	const imagePromiseCache:
		ImagePromiseCache =
		portfolioWindow
			.__portfolioLightboxImagePromises ||
		new Map<
			string,
			Promise<HTMLImageElement>
		>();


	portfolioWindow
		.__portfolioLightboxImageCache =
		imageCache;


	portfolioWindow
		.__portfolioLightboxImagePromises =
		imagePromiseCache;


	let lightboxInitialized =
		false;


	/*
	 * ========================================
	 * 圖片載入
	 *
	 * 重要：
	 * 不再進入首頁後全部預載。
	 *
	 * 只有：
	 * 1. 使用者打開 Lightbox
	 * 2. 前一張
	 * 3. 下一張
	 *
	 * 才會載入圖片。
	 * ========================================
	 */

	function preloadImage(
		src: string
	): Promise<HTMLImageElement> {

		if (!src) {

			return Promise.reject(
				new Error(
					"圖片網址不存在"
				)
			);

		}


		/*
		 * 已經成功載入
		 */

		const cached =
			imageCache.get(src);


		if (
			cached &&
			cached.complete
		) {

			return Promise.resolve(
				cached
			);

		}


		/*
		 * 已經正在載入
		 */

		const existingPromise =
			imagePromiseCache.get(
				src
			);


		if (existingPromise) {

			return existingPromise;

		}


		const promise =
			new Promise<HTMLImageElement>(
				(resolve, reject) => {

					const image =
						new Image();


					image.decoding =
						"async";


					image.onload =
						async () => {

							try {

								/*
								 * 先完成解碼，
								 * 避免圖片下載完後
								 * 還沒真正繪製。
								 */

								if (
									typeof image.decode ===
									"function"
								) {

									try {

										await image.decode();

									} catch {

										/*
										 * 某些瀏覽器
										 * decode 可能失敗，
										 * 但圖片仍可使用。
										 */

									}

								}


								imageCache.set(
									src,
									image
								);


								resolve(
									image
								);


							} catch (error) {

								reject(
									error
								);

							}

						};


					image.onerror =
						() => {

							imagePromiseCache.delete(
								src
							);


							reject(
								new Error(
									`圖片載入失敗：${src}`
								)
							);

						};


					image.src =
						src;

				}
			);


		imagePromiseCache.set(
			src,
			promise
		);


		return promise;

	}


	/*
	 * ========================================
	 * 初始化 Lightbox
	 * ========================================
	 */

	function initLightbox() {

		if (
			lightboxInitialized
		) {

			return;

		}


		const modal =
			document.getElementById(
				"lightbox-modal"
			);


		const imageWrap =
			document.getElementById(
				"lightbox-image-wrap"
			);


		const lightboxImg =
			document.getElementById(
				"lightbox-img"
			) as
				HTMLImageElement |
				null;


		const loading =
			document.getElementById(
				"lightbox-loading"
			);


		const title =
			document.getElementById(
				"lightbox-title"
			);


		const meta =
			document.getElementById(
				"lightbox-meta"
			);


		const counter =
			document.getElementById(
				"lightbox-counter"
			);


		const caption =
			document.getElementById(
				"lightbox-caption"
			);


		const closeBtn =
			modal?.querySelector(
				".lightbox-close"
			);


		const prevBtn =
			modal?.querySelector(
				".lightbox-prev"
			);


		const nextBtn =
			modal?.querySelector(
				".lightbox-next"
			);


		const backdrop =
			modal?.querySelector(
				".lightbox-backdrop"
			);


		if (
			!modal ||
			!imageWrap ||
			!lightboxImg ||
			!loading ||
			!title ||
			!meta ||
			!counter ||
			!caption ||
			!closeBtn ||
			!prevBtn ||
			!nextBtn ||
			!backdrop
		) {

			return;

		}


		lightboxInitialized =
			true;


		let gallery:
			string[] = [];


		let galleryCaptions:
			string[] = [];


		let projectCaption =
			"";


		let currentIndex =
			0;


		let currentCrop:
			"contain" |
			"square" =
			"contain";


		/*
		 * ========================================
		 * Zoom
		 * ========================================
		 */

		let zoomLevel =
			1;


		const MIN_ZOOM =
			1;


		const MAX_ZOOM =
			3;


		const ZOOM_STEP =
			0.25;


		let translateX =
			0;


		let translateY =
			0;


		let isDragging =
			false;


		let dragStartX =
			0;


		let dragStartY =
			0;


		let dragOriginX =
			0;


		let dragOriginY =
			0;


		let touchStartX =
			0;


		let touchStartY =
			0;


		/*
		 * 防止快速切換圖片時，
		 * 舊圖片晚到覆蓋新圖片。
		 */

		let imageRequestId =
			0;


		/*
		 * ========================================
		 * Gallery
		 * ========================================
		 */

		function getGallery(
			card: Element
		): string[] {

			const galleryData =
				card.getAttribute(
					"data-zoom-gallery"
				);


			if (!galleryData) {

				return [];

			}


			try {

				const images =
					JSON.parse(
						galleryData
					);


				if (
					!Array.isArray(
						images
					)
				) {

					return [];

				}


				return images.filter(
					(image) =>
						typeof image ===
							"string" &&
						image.length > 0
				);


			} catch (error) {

				console.warn(
					"Lightbox gallery 讀取失敗：",
					error
				);


				return [];

			}

		}


		/*
		 * ========================================
		 * Gallery Captions
		 * ========================================
		 */

		function getGalleryCaptions(
			wrapper: Element
		): string[] {

			const data =
				wrapper.getAttribute(
					"data-gallery-captions"
				);


			if (!data) {

				return [];

			}


			try {

				const parsed =
					JSON.parse(
						data
					);


				if (
					!Array.isArray(
						parsed
					)
				) {

					return [];

				}


				return parsed.map(
					(item) =>
						typeof item ===
						"string"
							? item
							: ""
				);


			} catch (error) {

				console.warn(
					"Lightbox captions 讀取失敗：",
					error
				);


				return [];

			}

		}


		/*
		 * ========================================
		 * Zoom Reset
		 * ========================================
		 */

		function resetZoom() {

			zoomLevel =
				1;


			translateX =
				0;


			translateY =
				0;


			lightboxImg.style.transform =
				"translate3d(0, 0, 0) scale(1)";


			lightboxImg.classList.remove(
				"is-zoomed"
			);


			lightboxImg.classList.remove(
				"is-dragging"
			);

		}


		/*
		 * ========================================
		 * Zoom Update
		 * ========================================
		 */

		function updateZoom() {

			zoomLevel =
				Math.max(
					MIN_ZOOM,
					Math.min(
						MAX_ZOOM,
						zoomLevel
					)
				);


			if (
				zoomLevel <= 1
			) {

				translateX =
					0;

				translateY =
					0;

			}


			lightboxImg.style.transform =
				`translate3d(${translateX}px, ${translateY}px, 0) scale(${zoomLevel})`;


			if (
				zoomLevel > 1
			) {

				lightboxImg.classList.add(
					"is-zoomed"
				);

			} else {

				lightboxImg.classList.remove(
					"is-zoomed"
				);

			}

		}


		function setZoom(
			value: number
		) {

			zoomLevel =
				value;

			updateZoom();

		}


		function zoomIn() {

			setZoom(
				zoomLevel +
				ZOOM_STEP
			);

		}


		function zoomOut() {

			setZoom(
				zoomLevel -
				ZOOM_STEP
			);

		}


		/*
		 * ========================================
		 * Navigation
		 * ========================================
		 */

		function updateNavigationVisibility() {

			const hasMultipleImages =
				gallery.length >
				1;


			if (
				hasMultipleImages
			) {

				prevBtn.classList.remove(
					"is-hidden"
				);


				nextBtn.classList.remove(
					"is-hidden"
				);


				counter.classList.remove(
					"is-hidden"
				);

			} else {

				prevBtn.classList.add(
					"is-hidden"
				);


				nextBtn.classList.add(
					"is-hidden"
				);


				counter.classList.add(
					"is-hidden"
				);

			}

		}


		/*
		 * ========================================
		 * 預載前後圖片
		 *
		 * 只有使用者正在看 Lightbox 時，
		 * 才載入相鄰圖片。
		 * ========================================
		 */

		function preloadAdjacentImages() {

			if (
				gallery.length <=
				1
			) {

				return;

			}


			const previousIndex =
				currentIndex - 1 <
				0
					? gallery.length - 1
					: currentIndex - 1;


			const nextIndex =
				currentIndex + 1 >=
				gallery.length
					? 0
					: currentIndex + 1;


			/*
			 * 使用 requestIdleCallback
			 * 讓目前圖片先完成。
			 */

			const run =
				() => {

					preloadImage(
						gallery[
							previousIndex
						]
					).catch(
						() => {}
					);


					preloadImage(
						gallery[
							nextIndex
						]
					).catch(
						() => {}
					);

				};


			if (
				"requestIdleCallback" in
				window
			) {

				window.requestIdleCallback(
					run,
					{
						timeout:
							1000,
					}
				);

			} else {

				setTimeout(
					run,
					100
				);

			}

		}


		/*
		 * ========================================
		 * 顯示圖片
		 * ========================================
		 */

		async function showImage(
			index: number
		) {

			if (
				!gallery.length
			) {

				return;

			}


			if (
				index < 0
			) {

				index =
					gallery.length -
					1;

			}


			if (
				index >=
				gallery.length
			) {

				index =
					0;

			}


			currentIndex =
				index;


			const image =
				gallery[
					currentIndex
				];


			const requestId =
				++imageRequestId;


			resetZoom();


			/*
			 * 圖片完成前隱藏。
			 */

			lightboxImg.classList.remove(
				"is-loaded"
			);


			lightboxImg.classList.add(
				"is-loading"
			);


			loading.classList.add(
				"active"
			);


			/*
			 * 移除舊圖片，
			 * 避免 square 模式殘留。
			 */

			lightboxImg.removeAttribute(
				"src"
			);


			/*
			 * 頁數
			 */

			if (
				gallery.length >
				1
			) {

				counter.textContent =
					`${currentIndex + 1} / ${gallery.length}`;

			}


			/*
			 * ====================================
			 * Caption
			 * ====================================
			 */

			const individualCaption =
				galleryCaptions[
					currentIndex
				] ||
				"";


			const finalCaption =
				individualCaption ||
				projectCaption ||
				"";


			caption.textContent =
				finalCaption;


			if (
				finalCaption
			) {

				caption.classList.add(
					"has-caption"
				);

			} else {

				caption.classList.remove(
					"has-caption"
				);

			}


			/*
			 * ====================================
			 * 載入目前圖片
			 * ====================================
			 */

			try {

				const cached =
					imageCache.get(
						image
					);


				let loadedImage:
					| HTMLImageElement
					| undefined;


				if (
					cached &&
					cached.complete
				) {

					loadedImage =
						cached;

				} else {

					loadedImage =
						await preloadImage(
							image
						);

				}


				/*
				 * 使用者如果已經切換圖片，
				 * 舊 request 不再更新畫面。
				 */

				if (
					requestId !==
					imageRequestId
				) {

					return;

				}


				lightboxImg.src =
					loadedImage.src;


				lightboxImg.alt =
					title.textContent ||
					"";


				requestAnimationFrame(
					() => {

						if (
							requestId !==
							imageRequestId
						) {

							return;

						}


						lightboxImg.classList.remove(
							"is-loading"
						);


						lightboxImg.classList.add(
							"is-loaded"
						);


						loading.classList.remove(
							"active"
						);

					}
				);


			} catch (error) {

				if (
					requestId !==
					imageRequestId
				) {

					return;

				}


				lightboxImg.classList.remove(
					"is-loading"
				);


				loading.classList.remove(
					"active"
				);


				console.warn(
					"Lightbox 圖片載入失敗：",
					image,
					error
				);

			}


			/*
			 * ====================================
			 * 目前圖片完成後，
			 * 才慢慢預載前後兩張。
			 *
			 * 不再一次預載整個 gallery。
			 * ====================================
			 */

			preloadAdjacentImages();

		}


		/*
		 * ========================================
		 * 開啟 Lightbox
		 * ========================================
		 */

		function openLightbox(
			card: Element
		) {

			const wrapper =
				card.closest(
					".grid-item"
				);


			if (!wrapper) {

				return;

			}


			gallery =
				getGallery(
					card
				);


			if (
				!gallery.length
			) {

				console.warn(
					"Lightbox 沒有找到圖片：",
					card
				);

				return;

			}


			updateNavigationVisibility();


			/*
			 * ====================================
			 * Image Crop
			 * ====================================
			 */

			const crop =
				wrapper.getAttribute(
					"data-image-crop"
				);


			currentCrop =
				crop === "square"
					? "square"
					: "contain";


			projectCaption =
				wrapper.getAttribute(
					"data-lightbox-caption"
				) || "";


			galleryCaptions =
				getGalleryCaptions(
					wrapper
				);


			if (
				currentCrop ===
				"square"
			) {

				imageWrap.classList.add(
					"is-square"
				);

			} else {

				imageWrap.classList.remove(
					"is-square"
				);

			}


			/*
			 * ====================================
			 * 作品資訊
			 * ====================================
			 */

			const projectTitle =
				card.getAttribute(
					"data-title"
				) || "";


			const projectCategory =
				card.getAttribute(
					"data-category"
				) || "";


			const projectYear =
				card.getAttribute(
					"data-year"
				) || "";


			title.textContent =
				projectTitle;


			/*
			 * 分類 / 年份
			 */

			if (
				projectCategory &&
				projectYear
			) {

				meta.textContent =
					`${projectCategory} / ${projectYear}`;

			} else if (
				projectCategory
			) {

				meta.textContent =
					projectCategory;

			} else if (
				projectYear
			) {

				meta.textContent =
					projectYear;

			} else {

				meta.textContent =
					"";

			}


			currentIndex =
				0;


			/*
			 * ====================================
			 * 打開 Lightbox
			 *
			 * 這裡不再預載前三張。
			 *
			 * 只載入使用者正在看的第一張。
			 * ====================================
			 */

			modal.classList.add(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"false"
			);


			document.body.style.overflow =
				"hidden";


			showImage(
				0
			);

		}


		/*
		 * ========================================
		 * 關閉
		 * ========================================
		 */

		function closeModal() {

			imageRequestId +=
				1;


			modal.classList.remove(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"true"
			);


			document.body.style.overflow =
				"";


			resetZoom();


			lightboxImg.classList.remove(
				"is-loaded"
			);


			lightboxImg.classList.add(
				"is-loading"
			);


			loading.classList.remove(
				"active"
			);


			setTimeout(
				() => {

					if (
						!modal.classList.contains(
							"active"
						)
					) {

						lightboxImg.removeAttribute(
							"src"
						);


						title.textContent =
							"";


						meta.textContent =
							"";


						counter.textContent =
							"1 / 1";


						caption.textContent =
							"";


						caption.classList.remove(
							"has-caption"
						);


						prevBtn.classList.remove(
							"is-hidden"
						);


						nextBtn.classList.remove(
							"is-hidden"
						);


						counter.classList.remove(
							"is-hidden"
						);


						gallery =
							[];


						galleryCaptions =
							[];


						projectCaption =
							"";

					}

				},
				300
			);

		}


		/*
		 * ========================================
		 * Card click
		 * ========================================
		 */

		const handleCardClick =
			(event: Event) => {

				const target =
					event.target;


				if (
					!(
						target instanceof
						Element
					)
				) {

					return;

				}


				const card =
					target.closest(
						".product-card.is-zoom-mode[data-zoom-gallery]"
					);


				if (!card) {

					return;

				}


				const interactive =
					target.closest(
						"a, button"
					);


				if (
					interactive &&
					interactive !== card
				) {

					if (
						interactive.matches(
							".product-card"
						)
					) {

						event.preventDefault();

					} else {

						return;

					}

				}


				event.preventDefault();


				openLightbox(
					card
				);

			};


		document.addEventListener(
			"click",
			handleCardClick
		);


		/*
		 * ========================================
		 * Buttons
		 * ========================================
		 */

		closeBtn.addEventListener(
			"click",
			closeModal
		);


		backdrop.addEventListener(
			"click",
			closeModal
		);


		prevBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				if (
					gallery.length <=
					1
				) {

					return;

				}


				showImage(
					currentIndex -
					1
				);

			}
		);


		nextBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				if (
					gallery.length <=
					1
				) {

					return;

				}


				showImage(
					currentIndex +
					1
				);

			}
		);


		/*
		 * ========================================
		 * 滾輪縮放
		 * ========================================
		 */

		imageWrap.addEventListener(
			"wheel",
			(event) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {

					return;

				}


				event.preventDefault();


				if (
					event.deltaY < 0
				) {

					zoomIn();

				} else {

					zoomOut();

				}

			},
			{
				passive:
					false,
			}
		);


		/*
		 * ========================================
		 * 雙擊縮放
		 * ========================================
		 */

		lightboxImg.addEventListener(
			"dblclick",
			(event) => {

				event.preventDefault();


				if (
					zoomLevel > 1
				) {

					setZoom(
						1
					);

				} else {

					setZoom(
						2
					);

				}

			}
		);


		/*
		 * ========================================
		 * 滑鼠拖曳
		 * ========================================
		 */

		lightboxImg.addEventListener(
			"mousedown",
			(event) => {

				if (
					zoomLevel <=
					1
				) {

					return;

				}


				event.preventDefault();


				isDragging =
					true;


				dragStartX =
					event.clientX;


				dragStartY =
					event.clientY;


				dragOriginX =
					translateX;


				dragOriginY =
					translateY;


				lightboxImg.classList.add(
					"is-dragging"
				);

			}
		);


		window.addEventListener(
			"mousemove",
			(event) => {

				if (
					!isDragging
				) {

					return;

				}


				translateX =
					dragOriginX +
					(
						event.clientX -
						dragStartX
					);


				translateY =
					dragOriginY +
					(
						event.clientY -
						dragStartY
					);


				updateZoom();

			}
		);


		window.addEventListener(
			"mouseup",
			() => {

				if (
					!isDragging
				) {

					return;

				}


				isDragging =
					false;


				lightboxImg.classList.remove(
					"is-dragging"
				);

			}
		);


		/*
		 * ========================================
		 * 鍵盤
		 * ========================================
		 *
		 * + / = ：放大
		 * -     ：縮小
		 * 0     ：恢復 100%
		 * ←     ：上一張
		 * →     ：下一張
		 * ESC   ：關閉
		 * ========================================
		 */

		const handleKeydown =
			(event: KeyboardEvent) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {

					return;

				}


				if (
					event.key ===
					"Escape"
				) {

					closeModal();

					return;

				}


				if (
					event.key === "+" ||
					event.key === "="
				) {

					event.preventDefault();

					zoomIn();

					return;

				}


				if (
					event.key === "-"
				) {

					event.preventDefault();

					zoomOut();

					return;

				}


				if (
					event.key === "0"
				) {

					event.preventDefault();

					setZoom(
						1
					);

					return;

				}


				if (
					event.key ===
					"ArrowLeft"
				) {

					event.preventDefault();


					if (
						gallery.length >
						1
					) {

						showImage(
							currentIndex -
							1
						);

					}


					return;

				}


				if (
					event.key ===
					"ArrowRight"
				) {

					event.preventDefault();


					if (
						gallery.length >
						1
					) {

						showImage(
							currentIndex +
							1
						);

					}

				}

			};


		document.addEventListener(
			"keydown",
			handleKeydown
		);


		/*
		 * ========================================
		 * 手機滑動
		 * ========================================
		 */

		const handleTouchStart =
			(event: TouchEvent) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {

					return;

				}


				touchStartX =
					event.changedTouches[
						0
					].screenX;


				touchStartY =
					event.changedTouches[
						0
					].screenY;

			};


		const handleTouchEnd =
			(event: TouchEvent) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {

					return;

				}


				if (
					gallery.length <=
					1
				) {

					return;

				}


				const touchEndX =
					event.changedTouches[
						0
					].screenX;


				const touchEndY =
					event.changedTouches[
						0
					].screenY;


				const distanceX =
					touchEndX -
					touchStartX;


				const distanceY =
					touchEndY -
					touchStartY;


				/*
				 * 放大後：
				 * 只有明顯左右滑動才換圖。
				 */

				if (
					zoomLevel > 1
				) {

					if (
						Math.abs(
							distanceX
						) < 100
					) {

						return;

					}


					if (
						Math.abs(
							distanceY
						) >
						Math.abs(
							distanceX
						)
					) {

						return;

					}

				}


				if (
					Math.abs(
						distanceX
					) < 50
				) {

					return;

				}


				if (
					distanceX < 0
				) {

					showImage(
						currentIndex +
						1
					);

				} else {

					showImage(
						currentIndex -
						1
					);

				}

			};


		modal.addEventListener(
			"touchstart",
			handleTouchStart,
			{
				passive:
					true,
			}
		);


		modal.addEventListener(
			"touchend",
			handleTouchEnd,
			{
				passive:
					true,
			}
		);

	}


	/*
	 * ========================================
	 * 初始化
	 * ========================================
	 */

	if (
		document.readyState ===
		"loading"
	) {

		document.addEventListener(
			"DOMContentLoaded",
			initLightbox,
			{
				once:
					true,
			}
		);

	} else {

		initLightbox();

	}


	/*
	 * ========================================
	 * Astro View Transition
	 * ========================================
	 */

	document.addEventListener(
		"astro:after-swap",
		() => {

			lightboxInitialized =
				false;

			initLightbox();

		}
	);

</script>


