---
import type { CollectionEntry } from "astro:content";
import ProductCard from "./ProductCard.astro";

type Props = {
	projects: CollectionEntry<"projects">[];
};

const { projects } = Astro.props;


/*
 * ========================================
 * 作品年份排序
 *
 * 新 → 舊
 *
 * 例如：
 * 2026
 * 2026
 * 2025
 * 2024
 * 2023
 *
 * 其他作品資料與功能完全不變
 * ========================================
 */

const sortedProjects = [
	...projects,
].sort(
	(a, b) =>
		b.data.year - a.data.year
);


const grid = "projects";
---

<section
	class="product-grid"
	id="grid"
	data-grid={grid}
>
	{sortedProjects.map((project) => {
		const currentCategory =
			project.data.category || "None";

		return (
			<div
				data-category={currentCategory}
				class="grid-item"
			>
				<ProductCard
					product={project}
				/>
			</div>
		);
	})}
</section>


<!-- ========================================
     首頁 Lightbox

     只有 mode="zoom" 的作品會使用

     每個作品都有自己的圖片組：
     cover
     +
     Markdown 內文圖片

     例如 About Me：
     1 / 5
     2 / 5
     3 / 5
     4 / 5
     5 / 5
======================================== -->

<div
	id="lightbox-modal"
	class="lightbox"
	aria-hidden="true"
>
	<div
		class="lightbox-backdrop"
	></div>

	<button
		type="button"
		class="lightbox-close"
		aria-label="關閉"
	>
		×
	</button>

	<button
		type="button"
		class="lightbox-prev"
		aria-label="上一張"
	>
		<span></span>
	</button>

	<div class="lightbox-content">

		<img
			id="lightbox-img"
			src=""
			alt=""
			draggable="false"
		/>

		<div
			id="lightbox-title"
			class="lightbox-title"
		></div>

		<div
			id="lightbox-meta"
			class="lightbox-meta"
		></div>

		<div
			id="lightbox-counter"
			class="lightbox-counter"
		>
			1 / 1
		</div>

	</div>

	<button
		type="button"
		class="lightbox-next"
		aria-label="下一張"
	>
		<span></span>
	</button>
</div>


<script>
	/*
	 * ========================================
	 * Lightbox 初始化
	 *
	 * 修正：
	 * Astro 頁面切換後偶爾無法開啟 Lightbox
	 *
	 * 只有在 DOM 完整存在後
	 * 才會設定 initialized
	 * ========================================
	 */

	let lightboxInitialized = false;


	function initLightbox() {

		/*
		 * 如果目前這個 DOM 已經初始化
		 * 就不要重複綁定
		 */

		if (lightboxInitialized) {
			return;
		}


		/*
		 * ========================================
		 * 取得 DOM
		 * ========================================
		 */

		const modal =
			document.getElementById(
				"lightbox-modal"
			);

		const lightboxImg =
			document.getElementById(
				"lightbox-img"
			);

		const title =
			document.getElementById(
				"lightbox-title"
			);

		const meta =
			document.getElementById(
				"lightbox-meta"
			);

		const counter =
			document.getElementById(
				"lightbox-counter"
			);

		const closeBtn =
			modal?.querySelector(
				".lightbox-close"
			);

		const prevBtn =
			modal?.querySelector(
				".lightbox-prev"
			);

		const nextBtn =
			modal?.querySelector(
				".lightbox-next"
			);

		const backdrop =
			modal?.querySelector(
				".lightbox-backdrop"
			);


		/*
		 * ========================================
		 * DOM 還沒準備好
		 *
		 * 這裡不能設定：
		 *
		 * lightboxInitialized = true
		 *
		 * 否則之後 DOM 準備好時
		 * 就不會再次初始化
		 * ========================================
		 */

		if (
			!modal ||
			!lightboxImg ||
			!title ||
			!meta ||
			!counter ||
			!closeBtn ||
			!prevBtn ||
			!nextBtn ||
			!backdrop
		) {
			return;
		}


		/*
		 * ========================================
		 * DOM 完整存在
		 *
		 * 現在才正式標記初始化完成
		 * ========================================
		 */

		lightboxInitialized = true;


		/*
		 * ========================================
		 * Lightbox 狀態
		 * ========================================
		 */

		let gallery = [];

		let currentIndex = 0;

		let touchStartX = 0;


		/*
		 * ========================================
		 * 取得作品 Gallery
		 * ========================================
		 */

		function getGallery(card) {

			const galleryData =
				card.getAttribute(
					"data-zoom-gallery"
				);


			if (!galleryData) {
				return [];
			}


			try {

				const images =
					JSON.parse(
						galleryData
					);


				if (
					!Array.isArray(images)
				) {
					return [];
				}


				return images.filter(
					(image) =>
						typeof image ===
							"string" &&
						image.length > 0
				);

			} catch (error) {

				console.warn(
					"Lightbox gallery 讀取失敗：",
					error
				);

				return [];
			}
		}


		/*
		 * ========================================
		 * 顯示圖片
		 * ========================================
		 */

		function showImage(index) {

			if (!gallery.length) {
				return;
			}


			/*
			 * 循環切換
			 */

			if (index < 0) {

				index =
					gallery.length - 1;

			}


			if (
				index >= gallery.length
			) {

				index = 0;

			}


			currentIndex = index;


			const image =
				gallery[
					currentIndex
				];


			/*
			 * 清除舊的錯誤事件
			 */

			lightboxImg.onerror =
				null;


			lightboxImg.src =
				image;


			counter.textContent =
				`${currentIndex + 1} / ${gallery.length}`;
		}


		/*
		 * ========================================
		 * 開啟 Lightbox
		 * ========================================
		 */

		function openLightbox(card) {

			gallery =
				getGallery(card);


			/*
			 * 沒有圖片就不開啟
			 */

			if (!gallery.length) {

				console.warn(
					"Lightbox 沒有找到圖片：",
					card
				);

				return;
			}


			currentIndex = 0;


			/*
			 * ========================================
			 * 作品資料
			 * ========================================
			 */

			const projectTitle =
				card.getAttribute(
					"data-title"
				) || "";


			const projectCategory =
				card.getAttribute(
					"data-category"
				) || "";


			const projectYear =
				card.getAttribute(
					"data-year"
				) || "";


			title.textContent =
				projectTitle;


			meta.textContent =
				`${projectCategory} /${projectYear}`;


			/*
			 * 第一張圖片
			 */

			showImage(0);


			/*
			 * 開啟
			 */

			modal.classList.add(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"false"
			);


			document.body.style.overflow =
				"hidden";
		}


		/*
		 * ========================================
		 * 關閉 Lightbox
		 * ========================================
		 */

		function closeModal() {

			modal.classList.remove(
				"active"
			);


			modal.setAttribute(
				"aria-hidden",
				"true"
			);


			document.body.style.overflow =
				"";


			setTimeout(
				() => {

					if (
						!modal.classList.contains(
							"active"
						)
					) {

						lightboxImg.src =
							"";

						title.textContent =
							"";

						meta.textContent =
							"";

						counter.textContent =
							"1 / 1";
					}

				},
				300
			);
		}


		/*
		 * ========================================
		 * 點擊作品
		 *
		 * 只有：
		 *
		 * .is-zoom-mode
		 *
		 * 才會進 Lightbox
		 *
		 * mode="page"
		 * 不會被攔截
		 *
		 * mode="link"
		 * 不會被攔截
		 * ========================================
		 */

		const handleCardClick =
			(event) => {

				const target =
					event.target;


				if (
					!(
						target instanceof
						Element
					)
				) {
					return;
				}


				const card =
					target.closest(
						".product-card.is-zoom-mode[data-zoom-gallery]"
					);


				if (!card) {
					return;
				}


				event.preventDefault();


				openLightbox(
					card
				);
			};


		document.addEventListener(
			"click",
			handleCardClick
		);


		/*
		 * ========================================
		 * 關閉
		 * ========================================
		 */

		closeBtn.addEventListener(
			"click",
			closeModal
		);


		backdrop.addEventListener(
			"click",
			closeModal
		);


		/*
		 * ========================================
		 * 上一張
		 * ========================================
		 */

		prevBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				showImage(
					currentIndex - 1
				);

			}
		);


		/*
		 * ========================================
		 * 下一張
		 * ========================================
		 */

		nextBtn.addEventListener(
			"click",
			(event) => {

				event.stopPropagation();


				showImage(
					currentIndex + 1
				);

			}
		);


		/*
		 * ========================================
		 * ESC / 鍵盤左右鍵
		 * ========================================
		 */

		const handleKeydown =
			(event) => {

				if (
					!modal.classList.contains(
						"active"
					)
				) {
					return;
				}


				/*
				 * ESC
				 */

				if (
					event.key ===
					"Escape"
				) {

					closeModal();

					return;
				}


				/*
				 * 上一張
				 */

				if (
					event.key ===
					"ArrowLeft"
				) {

					event.preventDefault();


					showImage(
						currentIndex - 1
					);


					return;
				}


				/*
				 * 下一張
				 */

				if (
					event.key ===
					"ArrowRight"
				) {

					event.preventDefault();


					showImage(
						currentIndex + 1
					);
				}
			};


		document.addEventListener(
			"keydown",
			handleKeydown
		);


		/*
		 * ========================================
		 * 手機左右滑動
		 * ========================================
		 */

		const handleTouchStart =
			(event) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {
					return;
				}


				touchStartX =
					event
						.changedTouches[0]
						.screenX;
			};


		const handleTouchEnd =
			(event) => {

				if (
					!event.changedTouches ||
					!event.changedTouches.length
				) {
					return;
				}


				const touchEndX =
					event
						.changedTouches[0]
						.screenX;


				const distance =
					touchEndX -
					touchStartX;


				/*
				 * 滑動距離太短
				 * 視為普通點擊
				 */

				if (
					Math.abs(
						distance
					) < 50
				) {
					return;
				}


				/*
				 * 左滑
				 */

				if (
					distance < 0
				) {

					showImage(
						currentIndex + 1
					);

				}

				/*
				 * 右滑
				 */

				else {

					showImage(
						currentIndex - 1
					);

				}
			};


		modal.addEventListener(
			"touchstart",
			handleTouchStart,
			{
				passive: true,
			}
		);


		modal.addEventListener(
			"touchend",
			handleTouchEnd,
			{
				passive: true,
			}
		);

	}


	/*
	 * ========================================
	 * 初次載入
	 * ========================================
	 */

	if (
		document.readyState ===
		"loading"
	) {

		document.addEventListener(
			"DOMContentLoaded",
			initLightbox,
			{
				once: true,
			}
		);

	} else {

		initLightbox();

	}


	/*
	 * ========================================
	 * Astro View Transitions
	 *
	 * 頁面切換完成後
	 * 重新初始化 Lightbox
	 * ========================================
	 */

	document.addEventListener(
		"astro:after-swap",
		() => {

			/*
			 * 新頁面已經產生新的 DOM
			 *
			 * 舊的 initialized 狀態不能保留
			 */

			lightboxInitialized =
				false;


			/*
			 * 重新初始化
			 */

			initLightbox();

		}
	);
</script>


<style>

	/*
	 * ========================================
	 * Grid
	 * ========================================
	 */

	.product-grid {
		position: relative;

		overflow: hidden;

		display: grid;

		width: 100%;

		grid-template-columns:
			repeat(
				3,
				minmax(0, 1fr)
			);

		gap:
			1rem
			0.2rem;

		margin:
			1rem
			0
			6rem;

		min-height:
			400px;
	}


	.grid-item {
		display: block;

		width: 100%;
	}


	/*
	 * ========================================
	 * Lightbox 外層
	 * ========================================
	 */

	.lightbox {
		position: fixed;

		z-index: 999999;

		inset: 0;

		width: 100%;

		height: 100%;

		background:
			transparent;

		display: flex;

		justify-content:
			center;

		align-items:
			center;

		opacity: 0;

		visibility:
			hidden;

		pointer-events:
			none;

		transition:
			opacity
			0.3s ease,

			visibility
			0.3s ease;
	}


	.lightbox.active {
		opacity: 1;

		visibility:
			visible;

		pointer-events:
			auto;
	}


	/*
	 * ========================================
	 * 黑色透明背景
	 * ========================================
	 */

	.lightbox-backdrop {
		position: absolute;

		inset: 0;

		background:
			rgba(
				0,
				0,
				0,
				0.80
			);
	}


	/*
	 * ========================================
	 * Lightbox 內容
	 * ========================================
	 */

	.lightbox-content {
		position: relative;

		z-index: 2;

		display: flex;

		flex-direction:
			column;

		align-items:
			center;

		justify-content:
			center;

		width:
			min(
				90vw,
				1400px
			);

		height:
			90vh;

		pointer-events:
			none;
	}


	/*
	 * ========================================
	 * 大圖
	 * ========================================
	 */

	.lightbox-content img {
		display: block;

		max-width:
			100%;

		max-height:
			78vh;

		width: auto;

		height: auto;

		object-fit:
			contain;

		user-select:
			none;

		-webkit-user-select:
			none;

		-webkit-user-drag:
			none;

		pointer-events:
			none;
	}


	/*
	 * ========================================
	 * 標題
	 * ========================================
	 */

	.lightbox-title {
		margin-top:
			15px;

		color:
			#ffffff;

		font-size:
			16px;

		font-weight:
			600;

		text-align:
			center;
	}


	/*
	 * ========================================
	 * 類別 / 年份
	 * ========================================
	 */

	.lightbox-meta {
		margin-top:
			5px;

		color:
			#ffffff;

		font-size:
			12px;

		opacity:
			0.6;
	}


	/*
	 * ========================================
	 * 1 / 5
	 * ========================================
	 */

	.lightbox-counter {
		margin-top:
			10px;

		color:
			#ffffff;

		font-size:
			13px;

		opacity:
			0.65;
	}


	/*
	 * ========================================
	 * 按鈕
	 * ========================================
	 */

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;

		z-index: 10;

		border: 0;

		background:
			transparent;

		color:
			#ffffff;

		cursor:
			pointer;

		font-family:
			inherit;

		transition:
			opacity
			0.2s ease,

			transform
			0.2s ease;
	}


	/*
	 * ========================================
	 * 關閉
	 * ========================================
	 */

	.lightbox-close {
		top:
			18px;

		right:
			25px;

		width:
			55px;

		height:
			55px;

		font-size:
			44px;

		font-weight:
			200;

		line-height:
			1;
	}


	/*
	 * ========================================
	 * 左右箭頭
	 *
	 * 使用 CSS 線條繪製
	 * 不使用 < > 字元
	 *
	 * 角度約 120°
	 * ========================================
	 */

	.lightbox-prev,
	.lightbox-next {
		top:
			50%;

		width:
			70px;

		height:
			90px;

		transform:
			translateY(
				-50%
			);

		padding:
			0;

		display:
			flex;

		align-items:
			center;

		justify-content:
			center;
	}


	/*
	 * 箭頭線條
	 */

	.lightbox-prev span,
	.lightbox-next span {
		display:
			block;

		width:
			24px;

		height:
			24px;

		border-top:
			1.5px solid
			#ffffff;

		border-right:
			1.5px solid
			#ffffff;

		transition:
			transform
			0.2s ease,

			opacity
			0.2s ease;
	}


	/*
	 * ========================================
	 * 左箭頭
	 *
	 * <
	 * 約 120° 張開
	 * ========================================
	 */

	.lightbox-prev {
		left:
			20px;
	}


	.lightbox-prev span {
		transform:
			rotate(
				-135deg
			);
	}


	/*
	 * ========================================
	 * 右箭頭
	 *
	 * >
	 * 約 120° 張開
	 * ========================================
	 */

	.lightbox-next {
		right:
			20px;
	}


	.lightbox-next span {
		transform:
			rotate(
				45deg
			);
	}


	/*
	 * ========================================
	 * Hover
	 * ========================================
	 */

	.lightbox-close:hover,
	.lightbox-prev:hover,
	.lightbox-next:hover {
		opacity:
			0.55;
	}


	.lightbox-prev:hover {
		transform:
			translateY(
				-50%
			)
			scale(
				1.08
			);
	}


	.lightbox-next:hover {
		transform:
			translateY(
				-50%
			)
			scale(
				1.08
			);
	}


	/*
	 * ========================================
	 * Desktop Grid
	 * ========================================
	 */

	@media screen and (min-width: 64em) {

		.product-grid {
			grid-template-columns:
				repeat(
					5,
					minmax(
						0,
						1fr
					)
				) !important;
		}

	}


	@media screen and (min-width: 80em) {

		.product-grid {
			grid-template-columns:
				repeat(
					6,
					minmax(
						0,
						1fr
					)
				) !important;
		}

	}


	/*
	 * ========================================
	 * Mobile
	 *
	 * 手機版 Lightbox：
	 * - 滿版
	 * - 圖片縮小
	 * - 上下留白
	 * - 標題跟在圖片下方
	 * - 分類 / 年份跟在標題下方
	 * - 1 / 5 最後顯示
	 * - 左右箭頭靠近螢幕邊緣
	 * ========================================
	 */

	@media (max-width: 700px) {

		.lightbox-content {
			width:
				100vw;

			height:
				100vh;

			padding:
				60px
				20px
				40px;

			box-sizing:
				border-box;

			justify-content:
				center;
		}


		.lightbox-content img {
			width:
				auto;

			max-width:
				88vw;

			max-height:
				68vh;

			object-fit:
				contain;
		}


		.lightbox-title {
			margin-top:
				14px;

			font-size:
				14px;

			line-height:
				1.4;

			max-width:
				80vw;

			text-align:
				center;
		}


		.lightbox-meta {
			margin-top:
				4px;

			font-size:
				11px;

			line-height:
				1.4;
		}


		.lightbox-counter {
			margin-top:
				8px;

			font-size:
				12px;
		}


		.lightbox-close {
			top:
				8px;

			right:
				10px;

			width:
				45px;

			height:
				45px;

			font-size:
				36px;
		}


		/*
		 * 手機左右箭頭
		 */

		.lightbox-prev,
		.lightbox-next {
			top:
				50%;

			width:
				45px;

			height:
				70px;
		}


		.lightbox-prev {
			left:
				0;
