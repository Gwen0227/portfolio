---
import type { CollectionEntry } from "astro:content";

type Props = {
	product: CollectionEntry<"projects">;
};

const { product } = Astro.props;

const mode = product.data.mode || "page";

const projectLink =
	`/${product.data.slug || product.id}`;

const year =
	product.data.year || "2026";

const category =
	product.data.category || "Visual";

/*
 * ========================================
 * 建立這個作品自己的 Lightbox 圖片清單
 *
 * 第一張：
 * cover
 *
 * 後面：
 * Markdown 內文裡的所有圖片
 * ========================================
 */

const cover =
	product.data.cover;

const renderedHtml =
	product.rendered?.html || "";

const contentImages =
	Array.from(
		renderedHtml.matchAll(
			/<img[^>]+src=["']([^"']+)["']/gi
		)
	)
	.map((match) => match[1])
	.filter(Boolean);

const galleryImages =
	Array.from(
		new Set([
			cover,
			...contentImages,
		])
	);

const galleryJson =
	JSON.stringify(
		galleryImages
	);
---

{mode === "zoom" ? (
	<div
		class="product-card is-zoom-mode"
		data-zoom-gallery={galleryJson}
		data-title={product.data.title}
		data-category={category}
		data-year={year}
	>
		<div class="image-container">
			<img
				src={product.data.cover}
				alt={product.data.title}
				loading="lazy"
				class="protected-img"
				draggable="false"
			/>
		</div>

		<div class="project-info">
			<h3>
				{product.data.title}
			</h3>

			<div class="project-meta">
				<span class="category-tag">
					{category}
				</span>

				<span class="year-tag">
					/{year}
				</span>
			</div>
		</div>
	</div>
) : (
	<a
		href={projectLink}
		class="product-card is-page-mode project-link"
		data-project-link={projectLink}
		data-category={category}
	>
		<div class="image-container">
			<img
				src={product.data.cover}
				alt={product.data.title}
				loading="lazy"
				class="protected-img"
				draggable="false"
			/>
		</div>

		<div class="project-info">
			<h3>
				{product.data.title}
			</h3>

			<div class="project-meta">
				<span class="category-tag">
					{category}
				</span>

				<span class="year-tag">
					/{year}
				</span>
			</div>
		</div>
	</a>
)}

<script>
	/*
	 * ========================================
	 * 記錄「作品列表 → 作品詳細頁」
	 * 回去時保留原本的位置
	 * ========================================
	 */

	function saveProjectReturnState() {
		const currentUrl =
			window.location.pathname +
			window.location.search +
			window.location.hash;

		const params =
			new URLSearchParams(
				window.location.search
			);

		const category =
			params.get("category") || "all";

		const returnState = {
			url: currentUrl,
			scrollY: window.scrollY,
			category: category,
		};

		sessionStorage.setItem(
			"projectReturnState",
			JSON.stringify(returnState)
		);
	}

	function setupProjectLinks() {
		const links =
			document.querySelectorAll(
				"a.project-link"
			);

		links.forEach((link) => {
			link.onclick = () => {
				saveProjectReturnState();
			};
		});
	}

	setupProjectLinks();

	document.addEventListener(
		"astro:page-load",
		setupProjectLinks
	);
</script>

<style>
	.product-card,
	.product-card *,
	.product-card:hover,
	.product-card:hover * {
		background-color: transparent !important;
		box-shadow: none !important;
		outline: none !important;
		border: none !important;
	}

	.product-card {
		display: flex !important;
		flex-direction: column !important;

		width: 100% !important;

		text-decoration: none !important;

		color: #000000 !important;

		opacity: 1 !important;

		filter: none !important;
	}

	.is-zoom-mode {
		cursor: zoom-in;
	}

	.is-page-mode {
		cursor: pointer;
	}

	.image-container {
		width: 100% !important;

		aspect-ratio: 1 / 1 !important;

		height: auto !important;

		overflow: hidden !important;

		position: relative !important;

		background: #ffffff !important;

		opacity: 1 !important;

		filter: none !important;
	}

	.image-container::after {
		content: "";

		position: absolute;

		top: 0;
		left: 0;

		width: 100%;
		height: 100%;

		background-color:
			rgba(0, 0, 0, 0.25);

		opacity: 1;

		transition:
			opacity 0.3s ease;

		z-index: 1;

		pointer-events: none;
	}

	.protected-img {
		width: 100% !important;
		height: 100% !important;

		object-fit: cover !important;

		display: block !important;

		opacity: 1 !important;

		filter:
			blur(0.6px)
			brightness(1)
			contrast(1) !important;

		transition:
			filter 0.3s ease;

		user-select: none;

		-webkit-user-drag: none;

		z-index: 0;
	}

	.product-card:hover
	.image-container::after {
		opacity: 0;
	}

	.product-card:hover
	.protected-img {
		filter:
			blur(0)
			brightness(1)
			contrast(1) !important;

		opacity: 1 !important;
	}

	.project-info {
		padding:
			0.5rem 0 0 0 !important;

		width: 100% !important;
	}

	.project-info h3 {
		margin: 0 !important;

		font-size: 0.95rem !important;

		font-weight: 700 !important;

		line-height: 1.2 !important;

		color: #000000 !important;
	}

	.project-meta {
		display: flex !important;

		flex-direction: row !important;

		justify-content:
			space-between !important;

		align-items: baseline !important;

		margin-top:
			0.2rem !important;

		width: 100% !important;
	}

	.category-tag {
		font-size: 0.8rem !important;

		font-weight: 400 !important;

		color: #888888 !important;

		line-height: 1 !important;
	}

	.year-tag {
		font-size: 0.72rem !important;

		font-weight: 400 !important;

		color: #aaaaaa !important;
	}

	@media (max-width: 768px) {
		.project-info h3 {
			font-size: 0.9rem !important;
		}

		.category-tag {
			font-size: 0.75rem !important;
		}

		.year-tag {
			font-size: 0.68rem !important;
		}
	}
</style>