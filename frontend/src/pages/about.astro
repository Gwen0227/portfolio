---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About | Chen-Pei Jyuan";
---

<BaseLayout title={title}>
	<section class="content">

		<!-- ========================================
		     Hero
		======================================== -->

		<div class="about-hero">

			<!-- 左側文字 -->

			<div class="about-text">

				<h1>About</h1>

				<p class="intro">
					Hi , 我是沛涓
				</p>

				<p class="desc">
					擅長在不同品牌調性中體現獨特美感，作品涵蓋品牌識別重塑、行銷視覺、書籍封面、活動主視覺及實體包裝設計。具備5年以上設計經驗，從前期概念提案、視覺統籌到後期各通路素材的設計能力。
				</p>

			</div>


			<!-- ========================================
			     右側圓形圖片
			======================================== -->

			<div class="avatar-wrapper">

				<img
					src="/images/profile.jpg"
					alt="Chen-Pei Jyuan"
					class="avatar-img protected-img"
				/>

			</div>

		</div>


		<!-- ========================================
		     Work Experience
		======================================== -->

		<section class="work-experience">

			<h2>Work Experience</h2>

			<div class="experience-list">

				<!-- ====================================
				     Experience 01
				===================================== -->

				<div class="experience-item">

					<div class="experience-date">
						2024/1 – 2026在職
					</div>

					<div class="experience-content">

						<h3>
							台灣廣廈有聲圖書有限公司
						</h3>

						<p class="experience-role">
							Graphic Designer
						</p>

						<p class="experience-desc">
							負責書籍封面設計和各通路 Banner、行銷素材製作。
						</p>

					</div>

				</div>


				<!-- ====================================
				     Experience 02
				===================================== -->

				<div class="experience-item">

					<div class="experience-date">
						2022/7 – 2023/12
					</div>

					<div class="experience-content">

						<h3>
							火花設計有限公司
						</h3>

						<p class="experience-role">
							Brand &amp; Visual Designer
						</p>

						<p class="experience-desc">
							負責活動主視覺、印刷品及數位素材設計，
							與企劃及行銷團隊合作完成不同專案。
						</p>

						<ul class="experience-projects">

							<li>
								璞邸－品牌視覺設計
							</li>

							<li>
								長榮海運 ESG 報告書－版型設計
							</li>

							<li>
								BNI 生技生態圈－活動視覺、周邊設計
							</li>

							<li>
								inneraise－海藻鈣包裝設計
							</li>

							<li>
								遠傳每月 DM
							</li>

							<li>
								SOGO 每月 DM
							</li>

							<li>
								禪香不二－品牌延伸輔銷 DM
							</li>

						</ul>

					</div>

				</div>


				<!-- ====================================
				     Experience 03
				===================================== -->

				<div class="experience-item">

					<div class="experience-date">
						2019/4 – 2021/4
					</div>

					<div class="experience-content">

						<h3>
							GUSHA 有事創意有限公司
						</h3>

						<p class="experience-role">
							Brand &amp; Visual Designer
						</p>

						<p class="experience-desc">
							負責活動主視覺、印刷品及數位素材設計與品牌視覺重塑，
							與企劃及行銷團隊合作完成不同行銷圖文設計。
						</p>

					</div>

				</div>


				<!-- ====================================
				     Experience 04
				===================================== -->

				<div class="experience-item">

					<div class="experience-date">
						2018/4 – 2019/2
					</div>

					<div class="experience-content">

						<h3>
							純粹創意整合行銷公司之設計部（澄千設計）
						</h3>

						<p class="experience-role">
							外包美編
						</p>

						<p class="experience-desc">
							政府活動視覺設計、提案、完稿。
						</p>

					</div>

				</div>

			</div>

		</section>


		<!-- ========================================
		     Education
		======================================== -->

		<section class="education">

			<h2>Education</h2>

			<div class="education-content">

				<ul>

					<li>
						2014 / 9月 - 2018 / 6月
					</li>

					<li>
						國立台北教育大學 藝術與造形設計學系
					</li>

					<li>
						Bachelor of Fine Arts, B.F.A.
						藝術學士學位 | 畢業
					</li>

					<li>
						主修 藝術史 / 藝術理論 / 視覺設計
					</li>

				</ul>

			</div>

		</section>


		<!-- ========================================
		     Expertise / Tools
		======================================== -->

		<div class="skills">

			<!-- ====================================
			     Expertise
			===================================== -->

			<div class="skill-column">

				<h2>Expertise</h2>

				<ul>

					<li>
						Brand Identity
					</li>

					<li>
						Visual Design
					</li>

					<li>
						Packaging Design
					</li>

					<li>
						Typography
					</li>

				</ul>

			</div>


			<!-- ====================================
			     Tools
			===================================== -->

			<div class="skill-column">

				<h2>Tools</h2>

				<ul>

					<li>
						Adobe Illustrator
					</li>

					<li>
						Adobe Photoshop
					</li>

					<li>
						Adobe InDesign
					</li>

					<li>
						Figma
					</li>

					<li>
						Mac OS
					</li>

				</ul>

			</div>

		</div>

	</section>
</BaseLayout>


<style>

	/* ========================================
	   About 整體內容
	======================================== */

	.content {
		width: 100% !important;

		max-width: 100% !important;

		margin: 1.5rem 0 6rem;

		box-sizing: border-box;
	}


	/* ========================================
	   Hero
	======================================== */

	.about-hero {
		display: grid;

		grid-template-columns:
			minmax(0, 1fr)
			140px;

		column-gap: 4rem;

		align-items: start;

		width: 100%;

		margin-bottom: 4.5rem;
	}


	/* ========================================
	   左側文字
	======================================== */

	.about-text {
		min-width: 0;

		width: 100%;
	}


	h1 {
		font-size: 2rem;

		font-weight: 600;

		color: #000000;

		margin: 0 0 2rem 0;

		line-height: 1.3;
	}


	.intro {
		font-size: 1.15rem;

		color: #111111;

		margin: 0 0 1.25rem;

		line-height: 1.6;
	}


	.desc {
		width: 100%;

		max-width: 760px;

		font-size: 0.95rem;

		color: #444444;

		line-height: 1.85;

		margin: 0;
	}


	/* ========================================
	   右側圓形圖片
	======================================== */

	.avatar-wrapper {
		width: 140px;

		height: 140px;

		min-width: 140px;

		max-width: 140px;

		min-height: 140px;

		max-height: 140px;

		flex-shrink: 0;

		justify-self: end;

		border-radius: 50%;

		overflow: hidden;

		background-color: #f1f1f1;

		box-sizing: border-box;
	}


	.avatar-img {
		display: block;

		width: 100%;

		height: 100%;

		object-fit: cover;

		border-radius: 50%;

		user-select: none;

		-webkit-user-drag: none;

		filter: blur(0.6px);

		transition: filter 0.3s ease;
	}


	.avatar-img:hover {
		filter: blur(0);
	}


	/* ========================================
	   共用標題
	======================================== */

	h2 {
		font-size: 1rem;

		font-weight: 700;

		color: #000000;

		margin: 0 0 1.25rem;

		line-height: 1.3;
	}


	/* ========================================
	   Work Experience
	======================================== */

	.work-experience {
		width: 100%;

		margin-top: 0;

		padding-top: 2rem;

		border-top: 1px solid #eeeeee;
	}


	.experience-list {
		width: 100%;
	}


	.experience-item {
		display: grid;

		grid-template-columns:
			140px
			minmax(0, 1fr);

		column-gap: 3rem;

		width: 100%;

		align-items: start;

		margin-bottom: 2.75rem;
	}


	.experience-item:last-child {
		margin-bottom: 0;
	}


	.experience-date {
		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;

		white-space: nowrap;
	}


	.experience-content {
		min-width: 0;

		width: 100%;
	}


	.experience-content h3 {
		font-size: 0.95rem;

		font-weight: 600;

		color: #111111;

		margin: 0 0 0.25rem;

		line-height: 1.5;
	}


	.experience-role {
		font-size: 0.9rem;

		color: #444444;

		margin: 0 0 0.6rem;

		line-height: 1.6;
	}


	.experience-desc {
		width: 100%;

		max-width: 760px;

		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;

		margin: 0;
	}


	/* ========================================
	   Work Experience 專案列表
	   與 Expertise / Tools 完全相同
	======================================== */

	.experience-projects {
		list-style: none;

		padding: 0;

		margin: 0.75rem 0 0;

		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;
	}


	.experience-projects li {
		margin: 0 0 0.15rem;
	}


	.experience-projects li:last-child {
		margin-bottom: 0;
	}


	/* ========================================
	   Education
	======================================== */

	.education {
		width: 100%;

		margin-top: 3.5rem;

		padding-top: 2rem;

		border-top: 1px solid #eeeeee;
	}


	.education-content {
		width: 100%;
	}


	.education ul {
		list-style: none;

		padding: 0;

		margin: 0;

		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;
	}


	.education li {
		margin: 0 0 0.15rem;
	}


	.education li:last-child {
		margin-bottom: 0;
	}


	/* ========================================
	   Expertise / Tools
	======================================== */

	.skills {
		display: grid;

		grid-template-columns:
			minmax(0, 1fr)
			minmax(0, 1fr);

		column-gap: 4rem;

		width: 100%;

		margin-top: 3rem;

		padding-top: 2rem;

		border-top: 1px solid #eeeeee;

		box-sizing: border-box;
	}


	.skill-column {
		min-width: 0;
	}


	.skill-column ul {
		list-style: none;

		padding: 0;

		margin: 0;

		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;
	}


	.skill-column li {
		margin: 0 0 0.15rem;
	}


	.skill-column li:last-child {
		margin-bottom: 0;
	}


	/* ========================================
	   平板
	======================================== */

	@media (max-width: 1000px) {

		.about-hero {
			column-gap: 3rem;

			grid-template-columns:
				minmax(0, 1fr)
				140px;
		}


		.experience-item {
			grid-template-columns:
				130px
				minmax(0, 1fr);

			column-gap: 2.5rem;
		}


		.skills {
			column-gap: 2.5rem;
		}

	}


	/* ========================================
	   手機
	======================================== */

	@media (max-width: 768px) {

		.content {
			margin-top: 1.25rem;

			margin-bottom: 4rem;
		}


		.about-hero {
			display: grid;

			grid-template-columns:
				minmax(0, 1fr)
				120px;

			column-gap: 1.25rem;

			margin-bottom: 3.5rem;
		}


		.avatar-wrapper {
			width: 120px;

			height: 120px;

			min-width: 120px;

			max-width: 120px;

			min-height: 120px;

			max-height: 120px;
		}


		h1 {
			font-size: 1.3rem;

			margin-bottom: 1.5rem;
		}


		.intro {
			font-size: 1rem;

			margin-bottom: 1rem;
		}


		.desc {
			grid-column: 1 / -1;

			max-width: none;

			font-size: 0.9rem;

			line-height: 1.8;

			margin-top: 1.25rem;
		}


		/* ====================================
		   Work Experience
		===================================== */

		.work-experience {
			margin-top: 0;

			padding-top: 1.5rem;
		}


		.experience-item {
			grid-template-columns:
				100px
				minmax(0, 1fr);

			column-gap: 1.25rem;

			margin-bottom: 2.25rem;
		}


		.experience-date {
			font-size: 0.8rem;

			line-height: 1.7;

			white-space: normal;
		}


		.experience-content h3 {
			font-size: 0.9rem;
		}


		.experience-role {
			font-size: 0.85rem;

			margin-bottom: 0.5rem;
		}


		.experience-desc {
			font-size: 0.82rem;

			line-height: 1.75;
		}


		/* ====================================
		   Work Experience 專案
		   跟 Tools 同樣的比例
		===================================== */

		.experience-projects {
			font-size: 0.82rem;

			line-height: 1.8;
		}


		/* ====================================
		   Education
		===================================== */

		.education {
			margin-top: 2.75rem;

			padding-top: 1.5rem;
		}


		.education ul {
			font-size: 0.82rem;

			line-height: 1.8;
		}


		/* ====================================
		   Expertise / Tools
		===================================== */

		.skills {
			grid-template-columns: 1fr;

			row-gap: 2.5rem;

			column-gap: 0;

			margin-top: 2.5rem;

			padding-top: 1.5rem;
		}


		.skill-column ul {
			font-size: 0.82rem;

			line-height: 1.8;
		}

	}


	/* ========================================
	   很窄的手機
	======================================== */

	@media (max-width: 480px) {

		.about-hero {
			grid-template-columns:
				minmax(0, 1fr)
				100px;

			column-gap: 1rem;
		}


		.avatar-wrapper {
			width: 100px;

			height: 100px;

			min-width: 100px;

			max-width: 100px;

			min-height: 100px;

			max-height: 100px;
		}


		h1 {
			font-size: 1.3rem;
		}


		.intro {
			font-size: 0.95rem;
		}


		.desc {
			font-size: 0.88rem;
		}


		.experience-item {
			grid-template-columns:
				90px
				minmax(0, 1fr);

			column-gap: 1rem;
		}


		.experience-date {
			font-size: 0.75rem;
		}


		.experience-content h3 {
			font-size: 0.85rem;
		}


		.experience-role {
			font-size: 0.8rem;
		}


		.experience-desc {
			font-size: 0.78rem;
		}


		.experience-projects {
			font-size: 0.8rem;

			line-height: 1.8;
		}


		.education ul,
		.skill-column ul {
			font-size: 0.8rem;
		}

	}

</style>
