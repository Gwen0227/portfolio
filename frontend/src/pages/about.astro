---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About | Chen-Pei Jyuan";
---

<BaseLayout title={title}>
	<section class="content">
		<!-- 🎯 文字與大頭照雙欄區塊 -->
		<div class="about-hero">
			<div class="about-text">
				<h1>About</h1>

				<p class="intro">
					Hi , 我是沛涓 
				</p>

				<p class="desc">
					擅長在不同品牌調性中體現獨特美感，作品涵蓋品牌識別重塑、行銷視覺、書籍封面、活動主視覺及實體包裝設計。具備5年以上設計經驗，從前期概念提案、視覺統籌到後期各通路素材的設計能力。
				</p>
			</div>

			<div class="avatar-wrapper">
				<img 
					src="/images/profile.jpg" 
					alt="Chen-Pei Jyuan" 
					class="avatar-img protected-img" 
				/>
			</div>
		</div>

		<div class="info">
			<div>
				<h2>Education</h2>

				<ul>
					<li>2014 / 9月 - 2018 / 6月 </li>
					<li>國立台北教育大學 藝術與造形設計學系</li>
					<li>Bachelor of Fine Arts, B.F.A. 藝術學士 學位 | 畢業</li>
					<li>主修 藝術史 / 藝術理論 / 視覺設計</li>
				</ul>
			</div>

			<div>
				<h2>Expertise</h2>

				<ul>
					<li>Brand Identity</li>
					<li>Visual Design</li>
					<li>Packaging Design</li>
					<li>Typography</li>
				</ul>
			</div>

			<div>
				<h2>Tools</h2>

				<ul>
					<li>Adobe Illustrator</li>
					<li>Adobe Photoshop</li>
					<li>Adobe InDesign</li>
					<li>Figma</li>
					<li>Mac OS</li>
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.content {
		width: 100%;
		margin: 1.5rem 0 6rem;
		box-sizing: border-box;
	}

	/* 🎯 使用 Flexbox 確保左側文字區塊完全吃滿剩餘空間 */
	.about-hero {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 3rem;
		margin-bottom: 3rem;
		width: 100%;
	}

	.about-text {
		flex: 1 1 auto;      /* 👈 強制文字區塊隨視窗伸縮 */
		width: 100%;
		max-width: 100%;     /* 👈 取消固定寬度限制，讓文字自動順排 */
	}

	h1 {
		font-size: 2rem;
		font-weight: 700;
		color: #000000;
		margin: 0 0 1.5rem 0;
		line-height: 1.3;
	}

	.intro {
		font-size: 1.15rem;
		color: #111111;
		margin-bottom: 1rem;
		line-height: 1.6;
	}

	.desc {
		font-size: 0.95rem;
		color: #444444;
		line-height: 1.85;
		margin: 0;
		width: 100%;
		max-width: 100%;    /* 👈 確保段落文字會一路排到圓形邊界 */
	}

	/* 🎯 圓形照片：固定佔據視窗比例（最高 400px），並貼緊最右側 */
	.avatar-wrapper {
		flex: 0 0 auto;
		width: 22vw;
		min-width: 160px;
		max-width: 400px;
		aspect-ratio: 1 / 1;
		border-radius: 50%;
		overflow: hidden;
		background-color: #f9f9f9;
		margin-left: auto;
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition: filter 0.3s ease;
	}

	.avatar-img:hover {
		filter: blur(0);
	}

	.info {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 3rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid #eeeeee;
	}

	h2 {
		font-size: 1rem;
		font-weight: 700;
		color: #000000;
		margin-bottom: 1rem;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.9rem;
		color: #555555;
		line-height: 2;
	}

	/* 📱 手機與窄螢幕 */
	@media (max-width: 768px) {
		.about-hero {
			flex-direction: column-reverse;
			align-items: stretch;
			gap: 1.5rem;
		}

		.avatar-wrapper {
			width: 35vw;
			min-width: 130px;
			max-width: 180px;
			margin-bottom: 0.5rem;
		}

		h1 {
			font-size: 1.5rem;
		}

		.info {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>