---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About | Chen-Pei Jyuan";
---

<BaseLayout title={title}>
	<section class="content">

		<!-- ========================================
		     Hero
		======================================== -->

		<div class="about-hero">

			<!-- 左側文字 -->
			<div class="about-text">

				<h1>About</h1>

				<p class="intro">
					Hi , 我是沛涓
				</p>

				<p class="desc">
					擅長在不同品牌調性中體現獨特美感，作品涵蓋品牌識別重塑、行銷視覺、書籍封面、活動主視覺及實體包裝設計。具備5年以上設計經驗，從前期概念提案、視覺統籌到後期各通路素材的設計能力。
				</p>

			</div>


			<!-- ========================================
			     右側固定尺寸圓形圖片
			======================================== -->

			<div class="avatar-wrapper">
				<img
					src="/images/profile.jpg"
					alt="Chen-Pei Jyuan"
					class="avatar-img protected-img"
				/>
			</div>

		</div>


		<!-- ========================================
		     Education / Expertise / Tools
		======================================== -->

		<div class="info">

			<!-- Education -->

			<div class="info-column">
				<h2>Education</h2>

				<ul>
					<li>2014 / 9月 - 2018 / 6月</li>
					<li>國立台北教育大學 藝術與造形設計學系</li>
					<li>
						Bachelor of Fine Arts, B.F.A.
						藝術學士 學位 | 畢業
					</li>
					<li>
						主修 藝術史 / 藝術理論 / 視覺設計
					</li>
				</ul>
			</div>


			<!-- Expertise -->

			<div class="info-column">
				<h2>Expertise</h2>

				<ul>
					<li>Brand Identity</li>
					<li>Visual Design</li>
					<li>Packaging Design</li>
					<li>Typography</li>
				</ul>
			</div>


			<!-- Tools -->

			<div class="info-column">
				<h2>Tools</h2>

				<ul>
					<li>Adobe Illustrator</li>
					<li>Adobe Photoshop</li>
					<li>Adobe InDesign</li>
					<li>Figma</li>
					<li>Mac OS</li>
				</ul>
			</div>

		</div>

	</section>
</BaseLayout>


<style>
	/* ========================================
	   About 整體內容
	======================================== */

	.content {
		width: 100% !important;
		max-width: 100% !important;

		margin: 1.5rem 0 6rem;

		box-sizing: border-box;
	}


	/* ========================================
	   Hero
	======================================== */

	.about-hero {
		display: grid;

		/*
		 * 左側：
		 * 自動吃掉剩餘空間
		 *
		 * 右側：
		 * 固定 140px
		 *
		 * 因此瀏覽器放大時，
		 * 圓形圖片不會跟著變大。
		 */

		grid-template-columns:
			minmax(0, 1fr)
			140px;

		column-gap: 4rem;

		align-items: start;

		width: 100%;

		margin-bottom: 3.5rem;
	}


	/* ========================================
	   左側文字
	======================================== */

	.about-text {
		min-width: 0;

		width: 100%;
	}


	h1 {
		font-size: 2rem;
		font-weight: 700;

		color: #000000;

		margin: 0 0 2rem 0;

		line-height: 1.3;
	}


	.intro {
		font-size: 1.15rem;

		color: #111111;

		margin: 0 0 1.25rem;

		line-height: 1.6;
	}


	.desc {
		width: 100%;
		max-width: 760px;

		font-size: 0.95rem;

		color: #444444;

		line-height: 1.85;

		margin: 0;
	}


	/* ========================================
	   右側圓形圖片
	======================================== */

	.avatar-wrapper {

		/*
		 * ⭐ 最重要
		 *
		 * 固定 140px。
		 *
		 * 不使用：
		 * 20vw
		 * clamp()
		 * %
		 *
		 * 所以視窗再怎麼放大，
		 * 圓形都不會變大。
		 */

		width: 140px;
		height: 140px;

		min-width: 140px;
		max-width: 140px;

		min-height: 140px;
		max-height: 140px;

		flex-shrink: 0;

		justify-self: end;

		border-radius: 50%;

		overflow: hidden;

		background-color: #f1f1f1;

		box-sizing: border-box;
	}


	.avatar-img {
		display: block;

		width: 100%;
		height: 100%;

		object-fit: cover;

		border-radius: 50%;

		user-select: none;

		-webkit-user-drag: none;

		filter: blur(0.6px);

		transition: filter 0.3s ease;
	}


	.avatar-img:hover {
		filter: blur(0);
	}


	/* ========================================
	   下方資訊區
	======================================== */

	.info {

		display: grid;

		/*
		 * 三欄：
		 *
		 * Education
		 * Expertise
		 * Tools
		 */

		grid-template-columns:
			minmax(0, 1.5fr)
			minmax(0, 1fr)
			minmax(0, 1fr);

		column-gap: 4rem;

		margin-top: 3rem;

		padding-top: 2rem;

		border-top: 1px solid #eeeeee;

		width: 100%;

		box-sizing: border-box;
	}


	.info-column {
		min-width: 0;
	}


	h2 {
		font-size: 1rem;

		font-weight: 700;

		color: #000000;

		margin: 0 0 1rem;

		line-height: 1.3;
	}


	ul {
		list-style: none;

		padding: 0;

		margin: 0;

		font-size: 0.9rem;

		color: #666666;

		line-height: 1.8;
	}


	li {
		margin: 0 0 0.15rem;
	}


	li:last-child {
		margin-bottom: 0;
	}


	/* ========================================
	   平板
	======================================== */

	@media (max-width: 1000px) {

		.about-hero {
			column-gap: 3rem;

			grid-template-columns:
				minmax(0, 1fr)
				140px;
		}


		.info {
			column-gap: 2.5rem;
		}
	}


	/* ========================================
	   手機
	======================================== */

	@media (max-width: 768px) {

		.content {
			margin-top: 1.25rem;
			margin-bottom: 4rem;
		}


		.about-hero {

			/*
			 * 手機改成：
			 *
			 * 圖片在右上
			 * 文字在下面
			 *
			 * 保持圖片固定尺寸。
			 */

			display: grid;

			grid-template-columns:
				minmax(0, 1fr)
				120px;

			column-gap: 1.25rem;

			margin-bottom: 3rem;
		}


		.avatar-wrapper {
			width: 120px;
			height: 120px;

			min-width: 120px;
			max-width: 120px;

			min-height: 120px;
			max-height: 120px;
		}


		h1 {
			font-size: 1.7rem;

			margin-bottom: 1.5rem;
		}


		.intro {
			font-size: 1rem;

			margin-bottom: 1rem;
		}


		.desc {
			grid-column: 1 / -1;

			max-width: none;

			font-size: 0.9rem;

			line-height: 1.8;

			margin-top: 1.25rem;
		}


		.info {

			grid-template-columns: 1fr;

			row-gap: 2.5rem;

			column-gap: 0;

			margin-top: 2.5rem;

			padding-top: 1.5rem;
		}
	}


	/* ========================================
	   很窄的手機
	======================================== */

	@media (max-width: 480px) {

		.about-hero {

			grid-template-columns:
				minmax(0, 1fr)
				100px;

			column-gap: 1rem;
		}


		.avatar-wrapper {

			width: 100px;
			height: 100px;

			min-width: 100px;
			max-width: 100px;

			min-height: 100px;
			max-height: 100px;
		}


		h1 {
			font-size: 1.5rem;
		}


		.intro {
			font-size: 0.95rem;
		}


		.desc {
			font-size: 0.88rem;
		}


		ul {
			font-size: 0.88rem;
		}
	}
</style>