---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: {
			slug: project.data.slug,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;

if (!project) {
	throw new Error("Project not found");
}

const { Content } = await render(project);

const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;

const activeCategory = project.data?.category || "all";
---

<BaseLayout title={project.data.title}>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<article class="project-detail">
		<header class="project-header">
			<div class="project-title-row">
				<button
					id="back-btn"
					class="back-btn"
					type="button"
					aria-label="返回作品列表"
				>
					<span class="back-arrow">←</span>
				</button>

				<h1 class="main-title">
					{project.data.title}
				</h1>
			</div>
		</header>

		{project.data.cover && (
			<figure
				class="featured-image lightbox-trigger"
				data-lightbox-image={project.data.cover}
				data-lightbox-alt={project.data.title}
				data-lightbox-caption={project.data.coverCaption || ""}
				tabindex="0"
				role="button"
				aria-label="查看作品圖片"
			>
				<img
					src={project.data.cover}
					alt={project.data.title}
					class="protected-img"
				/>

				{project.data.coverCaption && (
					<figcaption>
						{project.data.coverCaption}
					</figcaption>
				)}
			</figure>
		)}

		<div class="prose">
			<Content />
		</div>
	</article>


	<!-- ========================================
	     Lightbox
	======================================== -->

	<div
		id="lightbox"
		class="lightbox"
		aria-hidden="true"
	>
		<button
			id="lightbox-close"
			class="lightbox-close"
			type="button"
			aria-label="關閉圖片"
		>
			×
		</button>

		<button
			id="lightbox-prev"
			class="lightbox-arrow lightbox-prev"
			type="button"
			aria-label="上一張"
		>
			←
		</button>

		<div class="lightbox-content">
			<img
				id="lightbox-image"
				class="lightbox-image"
				src=""
				alt=""
			/>

			<div
				id="lightbox-caption"
				class="lightbox-caption"
			></div>

			<div
				id="lightbox-counter"
				class="lightbox-counter"
			></div>
		</div>

		<button
			id="lightbox-next"
			class="lightbox-arrow lightbox-next"
			type="button"
			aria-label="下一張"
		>
			→
		</button>
	</div>
</BaseLayout>


<script>
	/* ========================================
	   返回作品列表
	======================================== */

	function setupBackButton() {
		const button =
			document.getElementById("back-btn");

		if (!button) return;

		/*
		 * 使用 onclick，
		 * 避免 Astro 頁面切換後重複綁定。
		 */

		button.onclick = () => {
			const savedState =
				sessionStorage.getItem(
					"projectReturnState"
				);

			if (savedState) {
				try {
					const state =
						JSON.parse(savedState);

					if (state.url) {
						sessionStorage.setItem(
							"restoreProjectScroll",
							String(
								state.scrollY || 0
							)
						);

						window.location.href =
							state.url;

						return;
					}
				} catch (error) {
					console.error(
						"無法讀取作品列表返回狀態：",
						error
					);
				}
			}

			window.location.href = "/";
		};
	}


	/* ========================================
	   回到作品列表後恢復捲動位置
	======================================== */

	function restoreProjectScroll() {
		const scrollValue =
			sessionStorage.getItem(
				"restoreProjectScroll"
			);

		if (!scrollValue) return;

		sessionStorage.removeItem(
			"restoreProjectScroll"
		);

		const scrollY =
			Number(scrollValue);

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				window.scrollTo({
					top: scrollY,
					behavior: "auto",
				});
			});
		});
	}


	/* ========================================
	   Lightbox
	======================================== */

	function setupLightbox() {
		const lightbox =
			document.getElementById("lightbox");

		const lightboxImage =
			document.getElementById(
				"lightbox-image"
			);

		const lightboxCaption =
			document.getElementById(
				"lightbox-caption"
			);

		const lightboxCounter =
			document.getElementById(
				"lightbox-counter"
			);

		const closeButton =
			document.getElementById(
				"lightbox-close"
			);

		const prevButton =
			document.getElementById(
				"lightbox-prev"
			);

		const nextButton =
			document.getElementById(
				"lightbox-next"
			);

		const featuredImage =
			document.querySelector(
				".featured-image.lightbox-trigger"
			);

		const contentImages =
			document.querySelectorAll(
				".prose img"
			);


		/* ====================================
		   確認 Lightbox 元件存在
		==================================== */

		if (
			!lightbox ||
			!lightboxImage ||
			!lightboxCaption ||
			!lightboxCounter ||
			!closeButton ||
			!prevButton ||
			!nextButton
		) {
			console.warn(
				"Lightbox 元件不存在"
			);

			return;
		}


		/* ====================================
		   防止重複初始化
		==================================== */

		if (
			lightbox.dataset.initialized ===
			"true"
		) {
			return;
		}

		lightbox.dataset.initialized =
			"true";


		/* ====================================
		   收集所有圖片
		==================================== */

		const imageItems = [];


		/* ====================================
		   1. Cover 圖片
		==================================== */

		if (featuredImage) {
			const src =
				featuredImage.getAttribute(
					"data-lightbox-image"
				);

			const alt =
				featuredImage.getAttribute(
					"data-lightbox-alt"
				) || "";

			const caption =
				featuredImage.getAttribute(
					"data-lightbox-caption"
				) || "";

			if (src) {
				imageItems.push({
					src,
					alt,
					caption,
				});
			}
		}


		/* ====================================
		   2. 作品內容圖片
		==================================== */

		contentImages.forEach((img) => {
			const src =
				img.getAttribute("src");

			if (!src) return;

			const alt =
				img.getAttribute("alt") || "";

			let caption = "";


			/* --------------------------------
			   嘗試抓取圖片下面的圖說
			-------------------------------- */

			const parent =
				img.parentElement;

			if (parent) {
				const nextElement =
					parent.nextElementSibling;

				if (
					nextElement &&
					nextElement.tagName === "P"
				) {
					const em =
						nextElement.querySelector(
							"em"
						);

					if (em) {
						caption =
							em.textContent?.trim() ||
							"";
					}
				}
			}


			/* --------------------------------
			   如果沒有圖說，
			   使用 alt
			-------------------------------- */

			if (!caption) {
				caption = alt;
			}


			imageItems.push({
				src,
				alt,
				caption,
			});
		});


		/* ====================================
		   Debug
		==================================== */

		console.log(
			"Lightbox 圖片數量：",
			imageItems.length
		);


		if (!imageItems.length) {
			console.warn(
				"沒有找到任何 Lightbox 圖片"
			);

			return;
		}


		let currentIndex = 0;


		/* ====================================
		   顯示圖片
		==================================== */

		function showImage(index) {
			if (!imageItems.length) {
				return;
			}


			/* --------------------------------
			   循環切換
			-------------------------------- */

			if (index < 0) {
				index =
					imageItems.length - 1;
			}

			if (
				index >=
				imageItems.length
			) {
				index = 0;
			}


			currentIndex = index;

			const item =
				imageItems[currentIndex];


			/* --------------------------------
			   設定圖片
			-------------------------------- */

			lightboxImage.src =
				item.src;

			lightboxImage.alt =
				item.alt || "";


			/* --------------------------------
			   設定圖說
			-------------------------------- */

			lightboxCaption.textContent =
				item.caption || "";


			/* --------------------------------
			   設定頁數
			-------------------------------- */

			lightboxCounter.textContent =
				`${currentIndex + 1} / ${imageItems.length}`;


			/* --------------------------------
			   一張圖片時隱藏左右按鈕
			-------------------------------- */

			if (
				imageItems.length <= 1
			) {
				prevButton.style.display =
					"none";

				nextButton.style.display =
					"none";

				lightboxCounter.style.display =
					"none";
			} else {
				prevButton.style.display =
					"flex";

				nextButton.style.display =
					"flex";

				lightboxCounter.style.display =
					"block";
			}
		}


		/* ====================================
		   開啟 Lightbox
		==================================== */

		function openLightbox(index) {
			console.log(
				"開啟 Lightbox：",
				index
			);


			showImage(index);


			lightbox.classList.add(
				"is-open"
			);


			lightbox.setAttribute(
				"aria-hidden",
				"false"
			);


			document.body.classList.add(
				"lightbox-open"
			);
		}


		/* ====================================
		   關閉 Lightbox
		==================================== */

		function closeLightbox() {
			lightbox.classList.remove(
				"is-open"
			);


			lightbox.setAttribute(
				"aria-hidden",
				"true"
			);


			document.body.classList.remove(
				"lightbox-open"
			);


			setTimeout(() => {
				if (
					!lightbox.classList.contains(
						"is-open"
					)
				) {
					lightboxImage.removeAttribute(
						"src"
					);
				}
			}, 250);
		}


		/* ====================================
		   Cover 點擊
		==================================== */

		if (featuredImage) {
			featuredImage.onclick =
				(event) => {
					event.preventDefault();

					openLightbox(0);
				};


			featuredImage.onkeydown =
				(event) => {
					if (
						event.key === "Enter" ||
						event.key === " "
					) {
						event.preventDefault();

						openLightbox(0);
					}
				};
		}


		/* ====================================
		   內容圖片點擊
		==================================== */

		contentImages.forEach(
			(img, index) => {
				img.classList.add(
					"lightbox-content-image"
				);

				img.style.cursor =
					"zoom-in";


				img.onclick =
					(event) => {
						event.preventDefault();


						/*
						 * Cover = 第 0 張
						 *
						 * 第一張內容圖片
						 * = 第 1 張
						 */

						openLightbox(
							index + 1
						);
					};
			}
		);


		/* ====================================
		   上一張
		==================================== */

		prevButton.onclick =
			(event) => {
				event.preventDefault();

				event.stopPropagation();

				showImage(
					currentIndex - 1
				);
			};


		/* ====================================
		   下一張
		==================================== */

		nextButton.onclick =
			(event) => {
				event.preventDefault();

				event.stopPropagation();

				showImage(
					currentIndex + 1
				);
			};


		/* ====================================
		   關閉按鈕
		==================================== */

		closeButton.onclick =
			(event) => {
				event.preventDefault();

				event.stopPropagation();

				closeLightbox();
			};


		/* ====================================
		   點黑色背景關閉
		==================================== */

		lightbox.onclick =
			(event) => {
				if (
					event.target ===
					lightbox
				) {
					closeLightbox();
				}
			};


		/* ====================================
		   鍵盤操作
		==================================== */

		const keyboardHandler =
			(event) => {
				if (
					!lightbox.classList.contains(
						"is-open"
					)
				) {
					return;
				}


				/* Esc */

				if (
					event.key === "Escape"
				) {
					event.preventDefault();

					closeLightbox();

					return;
				}


				/* 上一張 */

				if (
					event.key === "ArrowLeft"
				) {
					event.preventDefault();

					showImage(
						currentIndex - 1
					);

					return;
				}


				/* 下一張 */

				if (
					event.key === "ArrowRight"
				) {
					event.preventDefault();

					showImage(
						currentIndex + 1
					);

					return;
				}
			};


		document.addEventListener(
			"keydown",
			keyboardHandler
		);


		/* ====================================
		   手機左右滑動
		==================================== */

		let touchStartX = 0;
		let touchStartY = 0;


		lightbox.addEventListener(
			"touchstart",
			(event) => {
				const touch =
					event.changedTouches[0];

				touchStartX =
					touch.clientX;

				touchStartY =
					touch.clientY;
			},
			{
				passive: true,
			}
		);


		lightbox.addEventListener(
			"touchend",
			(event) => {
				const touch =
					event.changedTouches[0];

				const deltaX =
					touch.clientX -
					touchStartX;

				const deltaY =
					touch.clientY -
					touchStartY;


				/*
				 * 太短的不算滑動
				 */

				if (
					Math.abs(deltaX) < 50
				) {
					return;
				}


				/*
				 * 上下滑動不算
				 */

				if (
					Math.abs(deltaX) <=
					Math.abs(deltaY)
				) {
					return;
				}


				/*
				 * 往右滑
				 * → 上一張
				 */

				if (deltaX > 0) {
					showImage(
						currentIndex - 1
					);
				}


				/*
				 * 往左滑
				 * → 下一張
				 */

				else {
					showImage(
						currentIndex + 1
					);
				}
			},
			{
				passive: true,
			}
		);
	}


	/* ========================================
	   統一初始化
	======================================== */

	function initializeProjectPage() {
		setupBackButton();

		restoreProjectScroll();

		setupLightbox();
	}


	/* ========================================
	   第一次載入
	======================================== */

	if (
		document.readyState ===
		"loading"
	) {
		document.addEventListener(
			"DOMContentLoaded",
			initializeProjectPage,
			{
				once: true,
			}
		);
	} else {
		initializeProjectPage();
	}


	/* ========================================
	   Astro Client Router
	======================================== */

	document.addEventListener(
		"astro:page-load",
		() => {
			initializeProjectPage();
		}
	);
</script>


<style>
	/* ========================================
	   Project
	======================================== */

	.project-detail {
		width: 100%;
		margin: 1.5rem 0 6rem;
	}

	.project-header {
		width: 100%;
		margin-bottom: 1.5rem;
	}

	.project-title-row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		width: 100%;
	}

	.back-btn {
		flex-shrink: 0;

		width: 36px;
		height: 36px;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0;
		margin: 0;

		border: none;
		border-radius: 0;

		background: #f2f2f2;
		color: #000000;

		cursor: pointer;

		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.back-btn:hover {
		background: #000000;
		color: #ffffff;

		transform: translateX(-4px);
	}

	.back-arrow {
		font-size: 1.1rem;
		line-height: 1;
	}

	.main-title {
		flex: 1;

		margin: 0;

		font-size: 2rem;
		font-weight: 600;
		line-height: 1.3;

		color: #000000;
	}


	/* ========================================
	   封面圖片
	======================================== */

	.featured-image {
		width: 100%;

		margin: 0 0 2.5rem;
		padding: 0;

		cursor: zoom-in;
	}

	.featured-image img {
		display: block;

		width: 100%;
		height: auto;

		aspect-ratio: 16 / 9;
		object-fit: cover;

		border-radius: 0;

		filter: blur(0.6px);

		user-select: none;
		-webkit-user-drag: none;

		transition:
			filter 0.25s ease;
	}

	.featured-image:hover img {
		filter: blur(0);
	}


	/* ========================================
	   封面圖說
	======================================== */

	.featured-image figcaption {
		display: block;

		margin-top: 0.5rem;

		font-size: 0.8rem;
		line-height: 1.5;

		color: #888888;

		cursor: default;
	}


	/* ========================================
	   文章內容
	======================================== */

	.prose {
		width: 100%;
		max-width: none;

		font-size: 0.95rem;
		line-height: 1.85;

		color: #000000;
	}

	.prose :global(p) {
		margin: 0 0 1.5rem;
	}


	/* ========================================
	   中標題
	======================================== */

	.prose :global(h2) {
		position: relative;

		margin-top: 3rem;
		margin-bottom: 2.6rem;

		padding-bottom: 0;

		font-size: 1.1rem;
		line-height: 1.3;
	}

	.prose :global(h2)::after {
		content: "";

		position: absolute;

		left: 0;
		bottom: -1.5rem;

		width: 2em;
		height: 1px;

		background: #000000;

		transform: rotate(-25deg);
		transform-origin: left center;
	}

	.prose :global(h3) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;

		font-size: 1.2rem;
		line-height: 1.4;
	}


	/* ========================================
	   一般圖片
	======================================== */

	.prose :global(img) {
		display: block;

		width: 100%;
		height: auto;

		margin: 1.5rem 0;

		border-radius: 0;

		user-select: none;
		-webkit-user-drag: none;

		transition:
			opacity 0.2s ease;

		cursor: zoom-in;
	}

	.prose :global(img:hover) {
		opacity: 0.9;
	}


	/* ========================================
	   單張圖片圖說
	======================================== */

	.prose
		:global(
			p:has(> img:only-child)
			+ p:has(> em:only-child)
		) {
		margin-top: -1.2rem;
		margin-bottom: 2rem;
	}

	.prose
		:global(
			p:has(> img:only-child)
			+ p:has(> em:only-child)
		)
		em {
		display: block;

		font-size: 0.8rem;
		line-height: 1.5;

		color: #888888;
	}


	/* ========================================
	   兩張圖片並排
	======================================== */

	.prose :global(.image-grid) {
		display: grid;

		grid-template-columns:
			repeat(2, minmax(0, 1fr));

		width: 100%;

		column-gap: 0.3rem;
		row-gap: 0.3rem;

		margin: 1.5rem 0 0;
		padding: 0;
	}

	.prose :global(.image-grid img) {
		display: block;

		width: 100%;
		height: auto;

		margin: 0 !important;
		padding: 0;

		border-radius: 0;

		user-select: none;
		-webkit-user-drag: none;

		cursor: zoom-in;
	}


	/* ========================================
	   兩張圖片共同圖說
	======================================== */

	.prose :global(.image-grid + p) {
		display: block;

		margin-top: 0.5rem;
		margin-bottom: 2rem;
	}

	.prose :global(.image-grid + p em) {
		display: block;

		font-size: 0.8rem;
		line-height: 1.5;

		color: #888888;
	}


	/* ========================================
	   連結
	======================================== */

	.prose :global(a) {
		color: inherit;

		text-decoration: underline;
		text-underline-offset: 3px;
	}


	/* ========================================
	   清單
	======================================== */

	.prose :global(ul),
	.prose :global(ol) {
		margin: 1.5rem 0;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.5rem;
	}


	/* ========================================
	   Lightbox
	======================================== */

	.lightbox {
		position: fixed;

		inset: 0;

		z-index: 9999;

		display: flex;
		align-items: center;
		justify-content: center;

		width: 100vw;
		height: 100vh;

		padding: 4rem 5rem;

		box-sizing: border-box;

		background: rgba(0, 0, 0, 0.82);

		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);

		opacity: 0;
		visibility: hidden;

		pointer-events: none;

		transition:
			opacity 0.25s ease,
			visibility 0.25s ease;
	}

	.lightbox.is-open {
		opacity: 1;

		visibility: visible;

		pointer-events: auto;
	}


	/* ========================================
	   Lightbox 圖片區
	======================================== */

	.lightbox-content {
		position: relative;

		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;

		width: 100%;
		height: 100%;

