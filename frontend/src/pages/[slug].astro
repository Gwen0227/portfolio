---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

const { project } = Astro.props;

if (!project) {
	throw new Error("Project not found");
}

const { Content } = await render(project);

// 所有專案
const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;

// 目前分類
const activeCategory = project.data?.category || "all";
---

<BaseLayout title={project.data.title}>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<article class="project-detail">

		<!-- ========================================
		     專案標題
		======================================== -->
		<header class="project-header">
			<h1 class="main-title">{project.data.title}</h1>
		</header>


		<!-- ========================================
		     封面圖片
		======================================== -->
		{project.data.cover && (
			<figure class="featured-image">
				<img
					src={project.data.cover}
					alt={project.data.title}
					class="protected-img"
				/>
			</figure>
		)}


		<!-- ========================================
		     Markdown / MDX 內容
		======================================== -->
		<div class="prose">
			<Content />
		</div>

	</article>
</BaseLayout>


<style>
	/* ========================================
	   主容器
	======================================== */

	.project-detail {
		width: 100%;
		margin: 1.5rem 0 6rem;
		box-sizing: border-box;
	}


	/* ========================================
	   專案標題
	======================================== */

	.project-header {
		width: 100%;
		margin-bottom: 1.5rem;
	}

	.main-title {
		width: 100%;
		font-size: 3.2rem !important;
		font-weight: 500 !important;
		color: #000000 !important;
		margin: 0 !important;
		padding: 0 !important;
		line-height: 1.2 !important;
		letter-spacing: -0.02em !important;
	}


	/* ========================================
	   封面圖片
	======================================== */

	.featured-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 0 0 2.5rem 0;
		padding: 0;
		overflow: hidden;
		background: #f9f9f9;
		border-radius: 0;
		box-sizing: border-box;
	}

	.featured-image .protected-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		margin: 0;
		padding: 0;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition: filter 0.3s ease;
	}

	.featured-image .protected-img:hover {
		filter: blur(0);
	}


	/* ========================================
	   Markdown 內容
	======================================== */

	.prose {
		width: 100%;
		color: #222222;
		font-size: 0.95rem;
		line-height: 1.85;
		box-sizing: border-box;
	}


	/* ========================================
	   一般段落
	======================================== */

	.prose :global(p) {
		width: 100%;
		margin: 0 0 1.5rem;
		padding: 0;
		text-align: justify;
		word-break: break-word;
		box-sizing: border-box;
	}


	/* ========================================
	   文字段落
	======================================== */

	.prose :global(p:not(:has(> img))) {
		width: 100%;
		display: block;
	}


	/* ========================================
	   圖片 Grid
	   
	   MDX 使用：

	   <div class="image-grid">

	   ![圖片 1](/images/brand/0000.png)

	   ![圖片 2](/images/brand/0000.png)

	   </div>
	======================================== */

	.prose :global(.image-grid) {
		width: 100%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		margin: 2rem 0 2.5rem;
		padding: 0;
		box-sizing: border-box;
	}


	/* ========================================
	   Grid 裡面的圖片段落
	======================================== */

	.prose :global(.image-grid p) {
		width: 100%;
		margin: 0;
		padding: 0;
		text-align: left;
		box-sizing: border-box;
	}


	/* ========================================
	   Grid 裡面的圖片
	======================================== */

	.prose :global(.image-grid img) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		margin: 0;
		padding: 0;
		border-radius: 0;
		object-fit: cover;
		box-sizing: border-box;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition:
			filter 0.3s ease,
			transform 0.3s ease;
	}


	/* ========================================
	   Grid 圖片 Hover
	======================================== */

	.prose :global(.image-grid img:hover) {
		filter: blur(0);
	}


	/* ========================================
	   Grid 外的一般圖片
	======================================== */

	.prose :global(
		> p > img:only-child
	) {
		display: block;
		width: 100%;
		max-width: 100%;
		height: auto;
		margin: 0 0 1.5rem;
		border-radius: 0;
		box-sizing: border-box;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition: filter 0.3s ease;
	}


	.prose :global(
		> p > img:only-child:hover
	) {
		filter: blur(0);
	}


	/* ========================================
	   一般圖片
	======================================== */

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
		user-select: none;
		-webkit-user-drag: none;
	}


	/* ========================================
	   標題
	======================================== */

	.prose :global(h1) {
		width: 100%;
		font-size: 2.5rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 3.5rem !important;
		margin-bottom: 1rem !important;
		line-height: 1.25 !important;
		clear: both;
	}

	.prose :global(h2) {
		width: 100%;
		font-size: 1.6rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 3rem !important;
		margin-bottom: 0.75rem !important;
		line-height: 1.35 !important;
		clear: both;
	}

	.prose :global(h3) {
		width: 100%;
		font-size: 1.2rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 2rem !important;
		margin-bottom: 0.75rem !important;
		line-height: 1.35 !important;
		clear: both;
	}


	/* ========================================
	   斜線
	======================================== */

	.prose :global(hr.slash) {
		width: 40px;
		height: 0.8px;
		padding: 0;
		border: none;
		outline: none;
		background-color: #000000;
		margin: 1.5rem 0 2.2rem 0;
		transform: rotate(-25deg);
		transform-origin: left center;
		clear: both;
	}


	/* ========================================
	   圖說
	======================================== */

	.prose :global(p:has(> em)) {
		width: 100%;
		margin-top: -0.5rem;
		margin-bottom: 2.2rem;
		clear: both;
	}

	.prose :global(p > em) {
		font-style: normal;
		font-size: 0.8rem !important;
		color: #888888 !important;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}


	/* ========================================
	   Figure / Figcaption
	======================================== */

	.prose :global(figure) {
		width: 100%;
		margin: 0 0 2rem;
		padding: 0;
		clear: both;
	}

	.prose :global(figcaption) {
		margin-top: 0.5rem;
		font-style: normal;
		font-size: 0.8rem !important;
		color: #888888 !important;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}


	/* ========================================
	   清單
	======================================== */

	.prose :global(ul),
	.prose :global(ol) {
		width: 100%;
		margin-left: 1.2rem;
		margin-bottom: 1.5rem;
		clear: both;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}


	/* ========================================
	   連結
	======================================== */

	.prose :global(a) {
		word-break: break-word;
	}


	/* ========================================
	   粗體
	======================================== */

	.prose :global(strong) {
		font-weight: 700;
	}


	/* ========================================
	   斜體
	======================================== */

	.prose :global(em) {
		font-style: italic;
	}


	/* ========================================
	   手機版
	======================================== */

	@media (max-width: 768px) {

		.main-title {
			font-size: 2rem !important;
		}

		.prose :global(h1) {
			font-size: 1.8rem !important;
		}

		.prose :global(h2) {
			font-size: 1.3rem !important;
			margin-top: 2rem !important;
		}

		.prose :global(h3) {
			font-size: 1.1rem !important;
			margin-top: 1.5rem !important;
		}


		/* ========================================
		   手機版 Image Grid
		   兩張圖片改成上下排列
		======================================== */

		.prose :global(.image-grid) {
			grid-template-columns: 1fr;
			gap: 0.8rem;
			margin: 1.5rem 0 2rem;
		}


		.prose :global(.image-grid p) {
			width: 100%;
			margin: 0;
		}


		.prose :global(.image-grid img) {
			width: 100%;
			max-width: 100%;
			height: auto;
		}


		/* ========================================
		   手機版一般圖片
		======================================== */

		.prose :global(
			> p > img:only-child
		) {
			width: 100%;
			max-width: 100%;
		}
	}
</style>