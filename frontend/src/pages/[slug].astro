---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: {
			slug: project.data.slug,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;

if (!project) {
	throw new Error("Project not found");
}

const { Content } = await render(project);

const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;

const activeCategory = project.data?.category || "all";
---

<BaseLayout title={project.data.title}>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<article class="project-detail">
		<header class="project-header">
			<div class="project-title-row">
				<button
					id="back-btn"
					class="back-btn"
					type="button"
					aria-label="返回作品列表"
				>
					<span class="back-arrow">←</span>
				</button>

				<h1 class="main-title">
					{project.data.title}
				</h1>
			</div>
		</header>

		{project.data.cover && (
			<figure class="featured-image">
				<img
					src={project.data.cover}
					alt={project.data.title}
					class="protected-img"
				/>
			</figure>
		)}

		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<script>
	function setupBackButton() {
		const button =
			document.getElementById("back-btn");

		if (!button) return;

		button.onclick = () => {
			const savedState =
				sessionStorage.getItem(
					"projectReturnState"
				);

			/*
			 * 有保存作品列表狀態：
			 * 回到原本的分類＋原本的位置。
			 */
			if (savedState) {
				try {
					const state = JSON.parse(savedState);

					if (state.url) {
						sessionStorage.setItem(
							"restoreProjectScroll",
							String(state.scrollY || 0)
						);

						window.location.href = state.url;
						return;
					}
				} catch (error) {
					console.error(
						"無法讀取作品列表返回狀態：",
						error
					);
				}
			}

			/*
			 * 如果沒有保存狀態，
			 * 最後才回首頁。
			 */
			window.location.href = "/";
		};
	}

	function restoreProjectScroll() {
		const scrollValue =
			sessionStorage.getItem(
				"restoreProjectScroll"
			);

		if (!scrollValue) return;

		sessionStorage.removeItem(
			"restoreProjectScroll"
		);

		const scrollY = Number(scrollValue);

		/*
		 * 等作品列表完成渲染後再恢復位置。
		 */
		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				window.scrollTo({
					top: scrollY,
					behavior: "instant",
				});
			});
		});
	}

	setupBackButton();

	document.addEventListener(
		"astro:page-load",
		() => {
			setupBackButton();
			restoreProjectScroll();
		}
	);
</script>

<style>
	.project-detail {
		width: 100%;
		margin: 1.5rem 0 6rem;
	}

	.project-header {
		width: 100%;
		margin-bottom: 1.5rem;
	}

	.project-title-row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		width: 100%;
	}

	.back-btn {
		flex-shrink: 0;
		width: 36px;
		height: 36px;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 0;
		margin: 0;

		border: none;
		border-radius: 0;

		background: #f2f2f2;
		color: #000000;

		cursor: pointer;

		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.back-btn:hover {
		background: #000000;
		color: #ffffff;
		transform: translateX(-4px);
	}

	.back-arrow {
		font-size: 1.1rem;
		line-height: 1;
	}

	.main-title {
		flex: 1;
		margin: 0;

		font-size: 2.3rem;
		font-weight: 700;
		line-height: 1.1;

		color: #000000;
	}

	.featured-image {
		width: 100%;
		margin: 0 0 2.5rem;
		padding: 0;
	}

	.featured-image img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;

		border-radius: 0;

		filter: blur(0.6px);
		user-select: none;
		-webkit-user-drag: none;
	}

	.prose {
		width: 100%;
		max-width: none;

		font-size: 0.95rem;
		line-height: 1.85;
		color: #000000;
	}

	.prose :global(p) {
		margin: 0 0 1.5rem;
	}

	.prose :global(h2) {
		margin-top: 3rem;
		margin-bottom: 1rem;

		font-size: 1.5rem;
		line-height: 1.3;
	}

	.prose :global(h3) {
		margin-top: 2.5rem;
		margin-bottom: 1rem;

		font-size: 1.2rem;
		line-height: 1.4;
	}

	.prose :global(img) {
		display: block;
		width: 100%;
		height: auto;
		margin: 1.5rem 0;

		border-radius: 0;

		user-select: none;
		-webkit-user-drag: none;
	}

	/*
	 * MDX：

	 * <div class="image-grid">
	 *
	 * ![圖片](...)
	 *
	 * ![圖片](...)
	 *
	 * </div>
	 */
	.prose :global(.image-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.3rem;

		width: 100%;
		margin: 2rem 0;
	}

	.prose :global(.image-grid img) {
		width: 100%;
		height: auto;
		margin: 0;
		border-radius: 0;
	}

	.prose :global(.image-grid + em) {
		display: block;

		margin-top: -1.25rem;
		margin-bottom: 2rem;

		font-size: 0.8rem;
		line-height: 1.5;
		color: #888888;
	}

	.prose :global(a) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 1.5rem 0;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.5rem;
	}

	@media (max-width: 768px) {
		.project-detail {
			margin-top: 1rem;
			margin-bottom: 4rem;
		}

		.project-title-row {
			gap: 0.6rem;
		}

		.back-btn {
			width: 32px;
			height: 32px;
		}

		.main-title {
			font-size: 1.7rem;
		}

		.prose {
			font-size: 0.9rem;
			line-height: 1.8;
		}

		.prose :global(.image-grid) {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>