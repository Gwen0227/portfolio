---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project },
	}));
}

const { project } = Astro.props;

if (!project) {
	throw new Error("Project not found");
}

const { Content } = await render(project);

// 所有專案
const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;

// 目前分類
const activeCategory = project.data?.category || "all";
---

<BaseLayout title={project.data.title}>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<article class="project-detail">

		<!-- 專案標題 -->
		<header class="project-header">
			<h1 class="main-title">{project.data.title}</h1>
		</header>

		<!-- 封面 -->
		{project.data.cover && (
			<figure class="featured-image">
				<img
					src={project.data.cover}
					alt={project.data.title}
					class="protected-img"
				/>
			</figure>
		)}

		<!-- Markdown / MDX 內容 -->
		<div class="prose">
			<Content />
		</div>

	</article>
</BaseLayout>

<style>
	/* ========================================
	   主容器
	======================================== */

	.project-detail {
		width: 100%;
		margin: 1.5rem 0 6rem;
		box-sizing: border-box;
	}


	/* ========================================
	   標題
	======================================== */

	.project-header {
		margin-bottom: 1.5rem;
	}

	.main-title {
		font-size: 3.2rem !important;
		font-weight: 500 !important;
		color: #000000 !important;
		margin: 0 !important;
		line-height: 1.2 !important;
		letter-spacing: -0.02em !important;
	}


	/* ========================================
	   封面圖片
	======================================== */

	.featured-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		margin: 0 0 2.5rem 0;
		overflow: hidden;
		background: #f9f9f9;
		border-radius: 4px;
	}

	.featured-image .protected-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition: filter 0.3s ease;
		margin: 0;
	}

	.featured-image .protected-img:hover {
		filter: blur(0);
	}


	/* ========================================
	   Markdown 內容
	======================================== */

	.prose {
		width: 100%;
		color: #222222;
		font-size: 0.95rem;
		line-height: 1.85;
		box-sizing: border-box;
	}


	/* ========================================
	   一般段落
	======================================== */

	.prose :global(p) {
		width: 100%;
		margin: 0 0 1.5rem;
		text-align: justify;
		word-break: break-word;
	}


	/* ========================================
	   圖片段落
	======================================== */

	/*
		只有一張圖片的段落：
		保持滿版
	*/

	.prose :global(p:has(> img:only-child)) {
		width: 100%;
		margin: 0 0 1.5rem;
		display: block;
	}


	/* ========================================
	   連續圖片自動並排
	======================================== */

	/*
		兩個連續的圖片 <p>：
		在桌面版變成左右兩欄。
	*/

	.prose :global(p:has(> img:only-child) + p:has(> img:only-child)) {
		margin-top: 0;
	}

	/*
		第一張圖片段落
	*/

	.prose :global(
		p:has(> img:only-child):not(:has(+ p:has(> img:only-child)))
	) {
		display: block;
	}


	/*
		只要圖片段落後面還有圖片段落，
		就讓兩張圖片使用 inline-block。
	*/

	.prose :global(p:has(> img:only-child)) {
		display: inline-block;
		vertical-align: top;
		width: calc(50% - 0.75rem);
		margin-right: 1.5rem;
		box-sizing: border-box;
	}

	/*
		每第二張圖片取消右邊距，
		讓左右兩張剛好填滿。
	*/

	.prose :global(
		p:has(> img:only-child) + p:has(> img:only-child)
	) {
		margin-right: 0;
	}


	/* ========================================
	   圖片本身
	======================================== */

	.prose :global(p:has(> img:only-child) > img) {
		display: block;
		width: 100%;
		height: auto;
		max-width: 100%;
		margin: 0;
		border-radius: 4px;
		object-fit: cover;
		box-sizing: border-box;
		user-select: none;
		-webkit-user-drag: none;
		filter: blur(0.6px);
		transition: filter 0.3s ease;
	}

	.prose :global(p:has(> img:only-child) > img:hover) {
		filter: blur(0);
	}


	/* ========================================
	   避免圖片後面的文字被並排影響
	======================================== */

	.prose :global(p:has(> img:only-child) + p:not(:has(> img:only-child))) {
		clear: both;
	}


	/* ========================================
	   一般圖片
	======================================== */

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 4px;
		user-select: none;
		-webkit-user-drag: none;
	}


	/* ========================================
	   標題
	======================================== */

	.prose :global(h1) {
		width: 100%;
		font-size: 2.5rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 3.5rem !important;
		margin-bottom: 1rem !important;
		line-height: 1.25 !important;
	}

	.prose :global(h2) {
		width: 100%;
		font-size: 1.6rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 3rem !important;
		margin-bottom: 0.75rem !important;
		line-height: 1.35 !important;
	}

	.prose :global(h3) {
		width: 100%;
		font-size: 1.2rem !important;
		font-weight: 700 !important;
		color: #000000 !important;
		margin-top: 2rem !important;
		margin-bottom: 0.75rem !important;
		line-height: 1.35 !important;
	}


	/* ========================================
	   斜線
	======================================== */

	.prose :global(hr.slash) {
		width: 40px;
		height: 0.8px;
		padding: 0;
		border: none;
		outline: none;
		background-color: #000000;
		margin: 1.5rem 0 2.2rem 0;
		transform: rotate(-25deg);
		transform-origin: left center;
	}


	/* ========================================
	   圖說
	======================================== */

	.prose :global(p:has(img) + p:has(em)) {
		width: 100%;
		display: block;
		margin-top: -0.5rem;
		margin-bottom: 2.2rem;
		clear: both;
	}

	.prose :global(p:has(img) + p:has(em) em) {
		font-style: normal;
		font-size: 0.8rem !important;
		color: #888888 !important;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}


	/* ========================================
	   Figure / Figcaption
	======================================== */

	.prose :global(figure) {
		margin: 0 0 2rem;
	}

	.prose :global(figcaption) {
		margin-top: 0.5rem;
		font-style: normal;
		font-size: 0.8rem !important;
		color: #888888 !important;
		line-height: 1.5;
		letter-spacing: 0.02em;
	}


	/* ========================================
	   清單
	======================================== */

	.prose :global(ul),
	.prose :global(ol) {
		width: 100%;
		margin-left: 1.2rem;
		margin-bottom: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}


	/* ========================================
	   手機版
	======================================== */

	@media (max-width: 768px) {

		.main-title {
			font-size: 2rem !important;
		}

		.prose :global(h1) {
			font-size: 1.8rem !important;
		}

		.prose :global(h2) {
			font-size: 1.3rem !important;
			margin-top: 2rem !important;
		}


		/* 手機版所有圖片上下排列 */

		.prose :global(p:has(> img:only-child)) {
			display: block;
			width: 100%;
			margin-right: 0;
			margin-bottom: 1.5rem;
		}

		.prose :global(p:has(> img:only-child) > img) {
			width: 100%;
			max-width: 100%;
			height: auto;
		}
	}
</style>