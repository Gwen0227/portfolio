---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";
import ProjectLightbox from "../components/ProjectLightbox.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: {
			slug: project.data.slug,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;

const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;
const activeCategory = project.data?.category || "all";

const renderedHtml = project.rendered?.html || "";
---

<BaseLayout title={project.data.title}>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<main class="project-detail">
		<h1 class="main-title">{project.data.title}</h1>

		{project.data.cover && (
			<figure class="featured-image">
				<img
					src={project.data.cover}
					alt={project.data.title}
					class="protected-img"
				/>

				{project.data.coverCaption && (
					<figcaption>
						{project.data.coverCaption}
					</figcaption>
				)}
			</figure>
		)}

		<div class="prose">
			<Fragment set:html={renderedHtml} />
		</div>
	</main>

	<ProjectLightbox />
</BaseLayout>

<style>
	/* =========================
	   PROJECT PAGE
	========================= */

	.project-detail {
		width: min(1200px, calc(100% - 40px));
		margin: 0 auto;
		padding: 60px 0 120px;
	}

	.main-title {
		margin: 0 0 40px;

		font-size: clamp(42px, 7vw, 100px);
		line-height: 0.95;
	}

	/* =========================
	   COVER
	========================= */

	.featured-image {
		margin: 0 0 60px;
	}

	.featured-image img {
		display: block;

		width: 100%;
		height: auto;

		cursor: zoom-in;

		-webkit-user-select: none;
		user-select: none;
		-webkit-user-drag: none;
	}

	.featured-image figcaption {
		margin-top: 12px;

		font-size: 14px;

		opacity: 0.6;
	}

	/* =========================
	   CONTENT
	========================= */

	.prose {
		width: 100%;
	}

	.prose img {
		display: block;

		width: 100%;
		max-width: 100%;
		height: auto;

		margin: 40px 0;

		cursor: zoom-in;

		-webkit-user-select: none;
		user-select: none;
		-webkit-user-drag: none;
	}

	.prose p {
		margin: 0 0 24px;
	}

	.prose h2,
	.prose h3 {
		margin-top: 60px;
		margin-bottom: 24px;
	}

	/* =========================
	   MOBILE
	========================= */

	@media (max-width: 700px) {
		.project-detail {
			width: calc(100% - 24px);
			padding-top: 40px;
		}

		.main-title {
			margin-bottom: 30px;
		}

		.featured-image {
			margin-bottom: 40px;
		}

		.prose img {
			margin: 30px 0;
		}
	}
</style>