---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: {
			slug: project.data.slug,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;

const { Content } = await render(project);

const allProjects = await getCollection("projects");

const productsTotal = allProjects.length;

const activeCategory =
	project.data?.category || "all";
---

<BaseLayout title={project.data.title}>

	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<main class="project-detail">

		<a
			href="/"
			class="back-link"
		>
			← Back
		</a>


		<header class="project-header">

			<h1 class="main-title">
				{project.data.title}
			</h1>

			<div class="project-meta">

				<span>
					{project.data.category || "Visual"}
				</span>

				<span>
					/{project.data.year}
				</span>

			</div>

		</header>


		<!-- =========================================
		     Cover
		========================================= -->

		<figure
			class="featured-image lightbox-trigger"
			data-lightbox-index="0"
		>
			<img
				src={project.data.cover}
				alt={project.data.title}
				class="protected-img"
			/>
		</figure>


		<!-- =========================================
		     Content
		========================================= -->

		<div class="prose">
			<Content />
		</div>


		<!-- =========================================
		     Lightbox
		========================================= -->

		<div
			id="lightbox"
			class="lightbox"
			aria-hidden="true"
		>

			<div
				class="lightbox-backdrop"
				data-lightbox-close
			></div>


			<button
				type="button"
				class="lightbox-close"
				aria-label="Close"
				data-lightbox-close
			>
				×
			</button>


			<button
				type="button"
				class="lightbox-prev"
				aria-label="Previous image"
				data-lightbox-prev
			>
				←
			</button>


			<div class="lightbox-content">

				<img
					id="lightbox-image"
					src=""
					alt=""
				/>

				<div
					id="lightbox-caption"
					class="lightbox-caption"
				></div>

				<div
					id="lightbox-counter"
					class="lightbox-counter"
				>
					1 / 1
				</div>

			</div>


			<button
				type="button"
				class="lightbox-next"
				aria-label="Next image"
				data-lightbox-next
			>
				→
			</button>

		</div>

	</main>


	<script is:inline>

		(function () {

			function initLightbox() {

				const lightbox =
					document.querySelector("#lightbox");

				const lightboxImage =
					document.querySelector("#lightbox-image");

				const counter =
					document.querySelector("#lightbox-counter");

				const caption =
					document.querySelector("#lightbox-caption");


				if (
					!lightbox ||
					!lightboxImage ||
					!counter
				) {
					return;
				}


				/*
				 * 避免 Astro 頁面切換後
				 * 重複建立 listener
				 */
				if (
					lightbox.dataset.initialized === "true"
				) {
					return;
				}

				lightbox.dataset.initialized = "true";


				function getImages() {

					const images = [];


					/* Cover */

					const cover =
						document.querySelector(
							".featured-image img"
						);

					if (cover) {

						images.push({
							src: cover.currentSrc || cover.src,
							alt: cover.alt || "",
						});

					}


					/* Content images */

					const contentImages =
						document.querySelectorAll(
							".prose img"
						);


					contentImages.forEach((img) => {

						const image =
							img as HTMLImageElement;

						images.push({
							src:
								image.currentSrc ||
								image.src,

							alt:
								image.alt || "",
						});

					});


					return images;
				}


				let currentIndex = 0;


				function showImage(index) {

					const images = getImages();

					if (!images.length) {
						return;
					}


					if (index < 0) {
						index = images.length - 1;
					}

					if (index >= images.length) {
						index = 0;
					}


					currentIndex = index;


					const item =
						images[currentIndex];


					lightboxImage.src =
						item.src;

					lightboxImage.alt =
						item.alt;


					counter.textContent =
						`${currentIndex + 1} / ${images.length}`;


					if (caption) {

						caption.textContent =
							item.alt;

					}

				}


				function openLightbox(index) {

					showImage(index);


					lightbox.classList.add(
						"is-open"
					);

					lightbox.setAttribute(
						"aria-hidden",
						"false"
					);


					document.body.style.overflow =
						"hidden";

				}


				function closeLightbox() {

					lightbox.classList.remove(
						"is-open"
					);

					lightbox.setAttribute(
						"aria-hidden",
						"true"
					);


					document.body.style.overflow =
						"";


					setTimeout(() => {

						lightboxImage.src = "";

					}, 300);

				}


				function nextImage() {

					showImage(
						currentIndex + 1
					);

				}


				function previousImage() {

					showImage(
						currentIndex - 1
					);

				}


				/*
				 * 點擊
				 */
				document.addEventListener(
					"click",
					(event) => {

						const target =
							event.target as HTMLElement;


						/*
						 * 圖片
						 */
						const image =
							target.closest(
								".featured-image img, .prose img"
							);


						if (image) {

							event.preventDefault();

							const images =
								getImages();

							const clickedSrc =
								(image as HTMLImageElement)
									.currentSrc ||
								(image as HTMLImageElement)
									.src;


							const index =
								images.findIndex(
									(item) =>
										item.src ===
										clickedSrc
								);


							openLightbox(
								index >= 0
									? index
									: 0
							);

							return;
						}


						/*
						 * 關閉
						 */
						if (
							target.closest(
								"[data-lightbox-close]"
							)
						) {

							closeLightbox();

							return;

						}


						/*
						 * 上一張
						 */
						if (
							target.closest(
								"[data-lightbox-prev]"
							)
						) {

							previousImage();

							return;

						}


						/*
						 * 下一張
						 */
						if (
							target.closest(
								"[data-lightbox-next]"
							)
						) {

							nextImage();

							return;

						}

					}
				);


				/*
				 * 鍵盤
				 */
				document.addEventListener(
					"keydown",
					(event) => {

						if (
							!lightbox.classList.contains(
								"is-open"
							)
						) {
							return;
						}


						if (
							event.key === "Escape"
						) {

							closeLightbox();

						}


						if (
							event.key === "ArrowRight"
						) {

							nextImage();

						}


						if (
							event.key === "ArrowLeft"
						) {

							previousImage();

						}

					}
				);


				/*
				 * 手機滑動
				 */
				let touchStartX = 0;

				let touchEndX = 0;


				lightbox.addEventListener(
					"touchstart",
					(event) => {

						touchStartX =
							event.changedTouches[0].screenX;

					},
					{
						passive: true,
					}
				);


				lightbox.addEventListener(
					"touchend",
					(event) => {

						touchEndX =
							event.changedTouches[0].screenX;


						const difference =
							touchEndX -
							touchStartX;


						if (
							Math.abs(difference) <
							50
						) {
							return;
						}


						if (difference < 0) {

							nextImage();

						} else {

							previousImage();

						}

					},
					{
						passive: true,
					}
				);

			}


			/*
			 * 第一次載入
			 */
			initLightbox();


			/*
			 * Astro ClientRouter
			 */
			document.addEventListener(
				"astro:page-load",
				initLightbox
			);

		})();

	</script>

</BaseLayout>


<style>

	.project-detail {
		width: 100%;
		padding: 0 1rem 6rem;
	}


	.back-link {
		display: inline-block;
		margin: 1rem 0 3rem;

		color: #666;
		text-decoration: none;

		font-size: 0.85rem;
	}


	.back-link:hover {
		color: #000;
	}


	.project-header {
		margin-bottom: 2rem;
	}


	.main-title {
		margin: 0;
		font-size: clamp(
			2rem,
			5vw,
			4rem
		);

		line-height: 1.05;
	}


	.project-meta {
		display: flex;
		justify-content: space-between;

		margin-top: 0.75rem;

		color: #888;

		font-size: 0.8rem;
	}


	.featured-image {
		width: 100%;
		margin: 0 0 3rem;

		cursor: zoom-in;
	}


	.featured-image img {
		display: block;

		width: 100%;
		height: auto;

		user-select: none;

		-webkit-user-drag: none;

		filter: blur(0.6px);

		transition:
			filter 0.3s ease;
	}


	.featured-image:hover img {
		filter: blur(0);
	}


	.prose {
		width: 100%;
	}


	.prose img {
		display: block;

		max-width: 100%;
		height: auto;

		margin: 2rem 0;

		cursor: zoom-in;

		user-select: none;

		-webkit-user-drag: none;

		filter: blur(0.6px);

		transition:
			filter 0.3s ease;
	}


	.prose img:hover {
		filter: blur(0);
	}


	/* =========================================
	   Lightbox
	========================================= */

	.lightbox {
		position: fixed;

		inset: 0;

		z-index: 99999;

		display: flex;

		align-items: center;
		justify-content: center;

		visibility: hidden;

		opacity: 0;

		pointer-events: none;

		transition:
			opacity 0.25s ease,
			visibility 0.25s ease;
	}


	.lightbox.is-open {
		visibility: visible;

		opacity: 1;

		pointer-events: auto;
	}


	.lightbox-backdrop {
		position: absolute;

		inset: 0;

		background:
			rgba(0, 0, 0, 0.92);
	}


	.lightbox-content {
		position: relative;

		z-index: 2;

		display: flex;

		flex-direction: column;

		align-items: center;

		justify-content: center;

		width: min(
			90vw,
			1400px
		);

		height: 90vh;

		pointer-events: none;
	}


	#lightbox-image {
		display: block;

		max-width: 100%;

		max-height: 82vh;

		width: auto;

		height: auto;

		object-fit: contain;

		pointer-events: auto;
	}


	.lightbox-caption {
		margin-top: 0.75rem;

		color: #fff;

		font-size: 0.8rem;

		text-align: center;
	}


	.lightbox-counter {
		position: absolute;

		bottom: -1rem;

		color: #fff;

		font-size: 0.75rem;
	}


	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;

		z-index: 10;

		border: 0;

		background: transparent;

		color: #fff;

		cursor: pointer;

		font-family: inherit;

		padding: 1rem;
	}


	.lightbox-close {
		top: 1rem;

		right: 1rem;

		font-size: 2.5rem;

		font-weight: 200;
	}


	.lightbox-prev {
		left: 1rem;

		font-size: 2.5rem;
	}


	.lightbox-next {
		right: 1rem;

		font-size: 2.5rem;
	}


	@media (max-width: 768px) {

		.lightbox-content {
			width: 92vw;

			height: 85vh;
		}


		#lightbox-image {
			max-width: 92vw;

			max-height: 75vh;
		}


		.lightbox-prev,
		.lightbox-next {
			font-size: 1.8rem;

			padding: 0.5rem;
		}


		.lightbox-close {
			top: 0.5rem;

			right: 0.5rem;

			font-size: 2rem;
		}

	}

</style>