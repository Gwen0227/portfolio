---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductGridHeader from "../components/ProductGridHeader.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects");

	return projects.map((project) => ({
		params: {
			slug: project.data.slug,
		},
		props: {
			project,
		},
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const allProjects = await getCollection("projects");
const productsTotal = allProjects.length;
const activeCategory = project.data?.category || "all";
---

<BaseLayout
	title={`${project.data.title} — Portfolio`}
	description={`${project.data.title} project`}
>
	<ProductGridHeader
		activeCategory={activeCategory}
		productsTotal={productsTotal}
	/>

	<main class="project-page">
		<div class="project-top">
			<a
				href="/"
				class="back-button"
				aria-label="Back to projects"
			>
				<span class="back-arrow">←</span>
				<span>Back</span>
			</a>
		</div>

		<header class="project-header">
			<h1>{project.data.title}</h1>

			<div class="project-meta">
				{project.data.year && <span>{project.data.year}</span>}
				{project.data.category && (
					<span>{project.data.category}</span>
				)}
			</div>
		</header>

		{
			project.data.cover && (
				<figure class="featured-image lightbox-trigger">
					<img
						src={project.data.cover}
						alt={project.data.title}
						class="protected-img"
						draggable="false"
					/>

					{
						project.data.coverCaption && (
							<figcaption>{project.data.coverCaption}</figcaption>
						)
					}
				</figure>
			)
		}

		<section class="project-content">
			<div class="prose">
				<Content />
			</div>
		</section>
	</main>

	<!-- =========================================================
	     LIGHTBOX
	     ========================================================= -->
	<div
		id="lightbox"
		class="lightbox"
		aria-hidden="true"
		role="dialog"
		aria-modal="true"
		aria-label="Image viewer"
	>
		<div class="lightbox-backdrop"></div>

		<button
			type="button"
			class="lightbox-close"
			aria-label="Close image viewer"
		>
			<span>×</span>
		</button>

		<button
			type="button"
			class="lightbox-arrow lightbox-prev"
			aria-label="Previous image"
		>
			<span>←</span>
		</button>

		<div class="lightbox-content">
			<img
				id="lightbox-image"
				src=""
				alt=""
				draggable="false"
			/>

			<div class="lightbox-caption" id="lightbox-caption"></div>

			<div class="lightbox-counter" id="lightbox-counter">
				1 / 1
			</div>
		</div>

		<button
			type="button"
			class="lightbox-arrow lightbox-next"
			aria-label="Next image"
		>
			<span>→</span>
		</button>
	</div>

	<script>
		/* =========================================================
		   PROJECT PAGE
		   ========================================================= */

		function setupBackButton() {
			const backButton = document.querySelector(".back-button");

			if (!backButton) return;

			backButton.onclick = (event) => {
				/*
				 * 如果有上一頁，就回上一頁。
				 * 如果沒有，就回首頁。
				 */
				if (window.history.length > 1) {
					event.preventDefault();
					window.history.back();
				}
			};
		}

		/* =========================================================
		   LIGHTBOX
		   ========================================================= */

		function setupLightbox() {
			const lightbox = document.querySelector("#lightbox");

			if (!lightbox) {
				console.warn("Lightbox 元素不存在");
				return;
			}

			const lightboxImage =
				lightbox.querySelector("#lightbox-image");

			const lightboxCaption =
				lightbox.querySelector("#lightbox-caption");

			const lightboxCounter =
				lightbox.querySelector("#lightbox-counter");

			const closeButton =
				lightbox.querySelector(".lightbox-close");

			const prevButton =
				lightbox.querySelector(".lightbox-prev");

			const nextButton =
				lightbox.querySelector(".lightbox-next");

			const backdrop =
				lightbox.querySelector(".lightbox-backdrop");

			if (
				!lightboxImage ||
				!closeButton ||
				!prevButton ||
				!nextButton ||
				!backdrop
			) {
				console.warn("Lightbox 元件不完整");
				return;
			}

			/*
			 * 防止 Astro 頁面切換時重複綁定事件。
			 */
			if (lightbox.dataset.initialized === "true") {
				return;
			}

			lightbox.dataset.initialized = "true";

			/* -------------------------------------------------------
			   收集所有圖片
			   ------------------------------------------------------- */

			const imageItems = [];

			/*
			 * 1. Cover
			 */
			const cover =
				document.querySelector(".featured-image img");

			if (cover) {
				imageItems.push({
					src: cover.currentSrc || cover.src,
					alt: cover.alt || "",
					caption:
						cover
							.closest("figure")
							?.querySelector("figcaption")
							?.textContent?.trim() || "",
				});
			}

			/*
			 * 2. 文章內圖片
			 */
			const contentImages =
				document.querySelectorAll(".prose img");

			contentImages.forEach((img) => {
				/*
				 * 如果文章內圖片跟 Cover 是同一個 DOM，
				 * 避免重複加入。
				 */
				if (img === cover) return;

				let caption = "";

				/*
				 * 嘗試找 figure / figcaption
				 */
				const figure = img.closest("figure");

				if (figure) {
					caption =
						figure
							.querySelector("figcaption")
							?.textContent?.trim() || "";
				}

				/*
				 * 如果沒有 figcaption，
				 * 嘗試找圖片後面緊接著的斜體文字。
				 */
				if (!caption) {
					const parent = img.parentElement;

					if (parent) {
						const nextElement =
							parent.nextElementSibling;

						if (
							nextElement?.tagName === "P" &&
							nextElement.querySelector("em")
						) {
							caption =
								nextElement
									.querySelector("em")
									.textContent?.trim() || "";
						}
					}
				}

				imageItems.push({
					src: img.currentSrc || img.src,
					alt: img.alt || "",
					caption,
				});
			});

			console.log(
				"Lightbox 圖片數量：",
				imageItems.length
			);

			if (imageItems.length === 0) {
				console.warn("Lightbox 沒有找到任何圖片");
				return;
			}

			/* -------------------------------------------------------
			   目前圖片
			   ------------------------------------------------------- */

			let currentIndex = 0;

			/* -------------------------------------------------------
			   更新圖片
			   ------------------------------------------------------- */

			function showImage(index) {
				if (imageItems.length === 0) return;

				/*
				 * 循環切換
				 */
				if (index < 0) {
					index = imageItems.length - 1;
				}

				if (index >= imageItems.length) {
					index = 0;
				}

				currentIndex = index;

				const item = imageItems[currentIndex];

				lightboxImage.src = item.src;
				lightboxImage.alt = item.alt;

				if (lightboxCaption) {
					lightboxCaption.textContent =
						item.caption || "";
				}

				if (lightboxCounter) {
					lightboxCounter.textContent =
						`${currentIndex + 1} / ${imageItems.length}`;
				}

				/*
				 * 只有一張圖片時，不需要左右按鈕。
				 */
				if (imageItems.length <= 1) {
					prevButton.classList.add("is-hidden");
					nextButton.classList.add("is-hidden");
				} else {
					prevButton.classList.remove("is-hidden");
					nextButton.classList.remove("is-hidden");
				}
			}

			/* -------------------------------------------------------
			   開啟
			   ------------------------------------------------------- */

			function openLightbox(index) {
				showImage(index);

				lightbox.classList.add("is-open");
				lightbox.setAttribute("aria-hidden", "false");

				document.documentElement.classList.add(
					"lightbox-open"
				);

				document.body.classList.add(
					"lightbox-open"
				);
			}

			/* -------------------------------------------------------
			   關閉
			   ------------------------------------------------------- */

			function closeLightbox() {
				lightbox.classList.remove("is-open");
				lightbox.setAttribute("aria-hidden", "true");

				document.documentElement.classList.remove(
					"lightbox-open"
				);

				document.body.classList.remove(
					"lightbox-open"
				);

				/*
				 * 清空圖片，避免關閉後仍然載入。
				 */
				window.setTimeout(() => {
					if (
						!lightbox.classList.contains(
							"is-open"
						)
					) {
						lightboxImage.src = "";
					}
				}, 250);
			}

			/* -------------------------------------------------------
			   Cover 點擊
			   ------------------------------------------------------- */

			if (cover) {
				cover.style.cursor = "zoom-in";

				cover.onclick = (event) => {
					event.preventDefault();
					event.stopPropagation();

					openLightbox(0);
				};
			}

			/* -------------------------------------------------------
			   文章內圖片點擊
			   ------------------------------------------------------- */

			contentImages.forEach((img, index) => {
				if (img === cover) return;

				img.style.cursor = "zoom-in";

				img.onclick = (event) => {
					event.preventDefault();
					event.stopPropagation();

					/*
					 * Cover 佔第 0 張，
					 * 所以文章圖片從第 1 張開始。
					 */
					openLightbox(index + 1);
				};
			});

			/* -------------------------------------------------------
			   上一張
			   ------------------------------------------------------- */

			prevButton.onclick = (event) => {
				event.preventDefault();
				event.stopPropagation();

				showImage(currentIndex - 1);
			};

			/* -------------------------------------------------------
			   下一張
			   ------------------------------------------------------- */

			nextButton.onclick = (event) => {
				event.preventDefault();
				event.stopPropagation();

				showImage(currentIndex + 1);
			};

			/* -------------------------------------------------------
			   關閉按鈕
			   ------------------------------------------------------- */

			closeButton.onclick = (event) => {
				event.preventDefault();
				event.stopPropagation();

				closeLightbox();
			};

			/* -------------------------------------------------------
			   點背景關閉
			   ------------------------------------------------------- */

			backdrop.onclick = () => {
				closeLightbox();
			};

			/* -------------------------------------------------------
			   點圖片本身不要關閉
			   ------------------------------------------------------- */

			lightboxImage.onclick = (event) => {
				event.stopPropagation();
			};

			/* -------------------------------------------------------
			   鍵盤
			   ------------------------------------------------------- */

			const handleKeydown = (event) => {
				if (!lightbox.classList.contains("is-open")) {
					return;
				}

				if (event.key === "Escape") {
					event.preventDefault();
					closeLightbox();
					return;
				}

				if (event.key === "ArrowLeft") {
					event.preventDefault();
					showImage(currentIndex - 1);
					return;
				}

				if (event.key === "ArrowRight") {
					event.preventDefault();
					showImage(currentIndex + 1);
				}
			};

			document.addEventListener(
				"keydown",
				handleKeydown
			);

			/* -------------------------------------------------------
			   手機左右滑動
			   ------------------------------------------------------- */

			let touchStartX = 0;
			let touchStartY = 0;

			lightbox.addEventListener(
				"touchstart",
				(event) => {
					if (!lightbox.classList.contains("is-open")) {
						return;
					}

					const touch = event.changedTouches[0];

					touchStartX = touch.clientX;
					touchStartY = touch.clientY;
				},
				{ passive: true }
			);

			lightbox.addEventListener(
				"touchend",
				(event) => {
					if (!lightbox.classList.contains("is-open")) {
						return;
					}

					const touch = event.changedTouches[0];

					const diffX =
						touch.clientX - touchStartX;

					const diffY =
						touch.clientY - touchStartY;

					/*
					 * 必須是明顯的水平滑動。
					 */
					if (
						Math.abs(diffX) > 50 &&
						Math.abs(diffX) > Math.abs(diffY)
					) {
						if (diffX > 0) {
							showImage(currentIndex - 1);
						} else {
							showImage(currentIndex + 1);
						}
					}
				},
				{ passive: true }
			);
		}

		/* =========================================================
		   INITIALIZE
		   ========================================================= */

		function initializeProjectPage() {
			setupBackButton();
			setupLightbox();
		}

		/*
		 * 初次載入
		 */
		if (document.readyState === "loading") {
			document.addEventListener(
				"DOMContentLoaded",
				initializeProjectPage,
				{ once: true }
			);
		} else {
			initializeProjectPage();
		}

		/*
		 * Astro Client Navigation
		 */
		document.addEventListener(
			"astro:page-load",
			() => {
				initializeProjectPage();
			}
		);
	</script>

	<style>
		/* =========================================================
		   PROJECT PAGE
		   ========================================================= */

		.project-page {
			width: 100%;
			padding: 0 0 8rem;
		}

		.project-top {
			display: flex;
			align-items: center;
			margin: 1.5rem 0 4rem;
		}

		.back-button {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			color: #111;
			text-decoration: none;
			font-size: 0.85rem;
			letter-spacing: 0.03em;
			transition:
				opacity 0.2s ease,
				transform 0.2s ease;
		}

		.back-button:hover {
			opacity: 0.55;
			transform: translateX(-3px);
		}

		.back-arrow {
			font-size: 1.1rem;
			line-height: 1;
		}

		.project-header {
			display: flex;
			align-items: flex-end;
			justify-content: space-between;
			gap: 2rem;
			margin-bottom: 2rem;
		}

		.project-header h1 {
			margin: 0;
			font-size: clamp(2.5rem, 7vw, 7rem);
			font-weight: 400;
			line-height: 0.95;
			letter-spacing: -0.05em;
		}

		.project-meta {
			display: flex;
			align-items: center;
			gap: 1rem;
			font-size: 0.75rem;
			color: #777;
			white-space: nowrap;
			padding-bottom: 0.5rem;
		}

		.project-meta span + span::before {
			content: "/";
			margin-right: 1rem;
			color: #bbb;
		}

		/* =========================================================
		   FEATURED IMAGE
		   ========================================================= */

		.featured-image {
			margin: 0;
			width: 100%;
			cursor: zoom-in;
		}

		.featured-image img {
			display: block;
			width: 100%;
			height: auto;
			max-height: 80vh;
			object-fit: contain;
			user-select: none;
			-webkit-user-drag: none;
		}

		.featured-image figcaption {
			margin-top: 0.75rem;
			font-size: 0.75rem;
			line-height: 1.5;
			color: #777;
		}

		/* =========================================================
		   CONTENT
		   ========================================================= */

		.project-content {
			width: 100%;
			max-width: 1000px;
			margin: 5rem auto 0;
		}

		.prose {
			font-size: 1rem;
			line-height: 1.8;
			color: #333;
		}

		.prose h2 {
			margin-top: 4rem;
			margin-bottom: 1.5rem;
			font-size: 2rem;
			font-weight: 400;
			line-height: 1.2;
		}

		.prose h3 {
			margin-top: 3rem;
			margin-bottom: 1rem;
			font-size: 1.4rem;
			font-weight: 400;
		}

		.prose p {
			margin: 0 0 1.5rem;
		}

		.prose img {
			display: block;
			width: 100%;
			height: auto;
			margin: 2rem 0;
			cursor: zoom-in;
			user-select: none;
			-webkit-user-drag: none;
		}

		.prose a {
			color: inherit;
		}

		.prose ul,
		.prose ol {
			padding-left: 1.5rem;
			margin-bottom: 2rem;
		}

		.prose li {
			margin-bottom: 0.5rem;
		}

		.prose blockquote {
			margin: 2rem 0;
			padding-left: 1.5rem;
			border-left: 1px solid #111;
		}

		/* =========================================================
		   IMAGE GRID
		   ========================================================= */

		.prose .image-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1rem;
			margin: 2rem 0;
		}

		.prose .image-grid img {
			width: 100%;
			height: auto;
			margin: 0;
		}

		/* =========================================================
		   LIGHTBOX
		   ========================================================= */

		html.lightbox-open,
		body.lightbox-open {
			overflow: hidden !important;
		}

		.lightbox {
			position: fixed;
			inset: 0;
			z-index: 999999;

			display: flex;
			align-items: center;
			justify-content: center;

			width: 100vw;
			height: 100vh;

			padding: 3rem;

			visibility: hidden;
			opacity: 0;

			pointer-events: none;

			transition:
				opacity 0.25s ease,
				visibility 0.25s ease;
		}

		.lightbox.is-open {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
		}

		/* =========================================================
		   BLACK BACKGROUND
		   ========================================================= */

		.lightbox-backdrop {
			position: absolute;
			inset: 0;

			width: 100%;
			height: 100%;

			background: rgba(0, 0, 0, 0.92);

			backdrop-filter: blur(8px);
			-webkit-backdrop-filter: blur(8px);

			cursor: zoom-out;
		}

		/* =========================================================
		   LIGHTBOX CONTENT
		   ========================================================= */

		.lightbox-content {
			position: relative;
			z-index: 2;

			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;

			width: 100%;
			height: 100%;

			pointer-events: none;
		}

		.lightbox-content img {
			display: block;

			max-width: min(86vw, 1400px);
			max-height: 82vh;

			width: auto;
			height: auto;

			object-fit: contain;

			user-select: none;
			-webkit-user-drag: none;

			pointer-events: auto;

			box-shadow:
				0 20px 80px rgba(0, 0, 0, 0.45);
		}

		/* =========================================================
		   CAPTION
		   ========================================================= */

		.lightbox-caption {
			position: relative;
			z-index: 3;

			min-height: 1.5rem;

			margin-top: 1rem;

			color: rgba(255, 255, 255, 0.8);

			font-size: 0.8rem;
			line-height: 1.5;
			text-align: center;

			pointer-events: none;
		}

		/* =========================================================
		   COUNTER
		   ========================================================= */

		.lightbox-counter {
			position: relative;
			z-index: 3;

			margin-top: 0.4rem;

			color: rgba(255, 255, 255, 0.45);

			font-size: 0.7rem;
			letter-spacing: 0.08em;

			pointer-events: none;
		}

		/* =========================================================
		   CLOSE
		   ========================================================= */

		.lightbox-close {
			position: absolute;
			z-index: 10;

			top: 1.5rem;
			right: 1.5rem;

			display: flex;
			align-items: center;
			justify-content: center;

			width: 3rem;
			height: 3rem;

			padding: 0;

			border: 0;
			border-radius: 50%;

			background: rgba(255, 255, 255, 0.12);
			color: #fff;

			font-family: inherit;
			font-size: 2rem;
			font-weight: 300;
			line-height: 1;

			cursor: pointer;

			transition:
				background 0.2s ease,
				transform 0.2s ease;
		}

		.lightbox-close:hover {
			background: rgba(255, 255, 255, 0.25);
			transform: rotate(90deg);
		}

		.lightbox-close span {
			display: block;
			transform: translateY(-1px);
		}

		/* =========================================================
		   ARROWS
		   ========================================================= */

		.lightbox-arrow {
			position: absolute;
			z-index: 10;

			top: 50%;
			transform: translateY(-50%);

			display: flex;
			align-items: center;
			justify-content: center;

			width: 4rem;
			height: 4rem;

			padding: 0;

			border: 0;
			border-radius: 50%;

			background: rgba(255, 255, 255, 0.12);
			color: #fff;

			font-family: inherit;
			font-size: 2rem;
			font-weight: 300;
			line-height: 1;

			cursor: pointer;

			transition:
				background 0.2s ease,
				transform 0.2s ease;
		}

		.lightbox-arrow:hover {
			background: rgba(255, 255, 255, 0.25);
		}

		.lightbox-prev {
			left: 1.5rem;
		}

		.lightbox-prev:hover {
			transform: translateY(-50%) translateX(-3px);
		}

		.lightbox-next {
			right: 1.5rem;
		}

		.lightbox-next:hover {
			transform: translateY(-50%) translateX(3px);
		}

		.lightbox-arrow.is-hidden {
			display: none;
		}

		/* =========================================================
		   MOBILE
		   ========================================================= */

		@media (max-width: 700px) {
			.project-top {
				margin-top: 1rem;
				margin-bottom: 3rem;
			}

			.project-header {
				display: block;
			}

			.project-header h1 {
				font-size: clamp(2.5rem, 13vw, 5rem);
			}

			.project-meta {
				margin-top: 1rem;
				padding-bottom: 0;
			}

			.featured-image img {
				max-height: 65vh;
			}

			.project-content {
				margin-top: 3rem;
			}

			.prose .image-grid {
				grid-template-columns: 1fr;
				gap: 0;
			}

			.prose .image-grid img {
				margin: 1rem 0;
			}

			.lightbox {
				padding: 1rem;
			}

			.lightbox-content img {
				max-width: 92vw;
				max-height: 75vh;
			}

			.lightbox-close {
				top: 0.75rem;
				right: 0.75rem;

